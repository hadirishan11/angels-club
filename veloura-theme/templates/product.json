{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "vendor"
        },
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "stock": {
          "type": "stock"
        },
        "variants": {
          "type": "variant_picker"
        },
        "buy": {
          "type": "buy_buttons",
          "settings": {
            "dynamic_checkout": true
          }
        },
        "notes": {
          "type": "notes"
        },
        "description": {
          "type": "description"
        },
        "specs": {
          "type": "specs",
          "settings": {
            "show_sku": false
          }
        },
        "shipping": {
          "type": "collapsible",
          "settings": {
            "heading": "Shipping & returns",
            "icon": "truck",
            "content": "<p>We ship across Canada. Rates and delivery estimates are shown at checkout. Fragrances contain alcohol and ship by ground where carriers require it. See our shipping and refund policies for full details.</p>"
          }
        },
        "mini": {
          "type": "collapsible",
          "settings": {
            "heading": "About miniatures",
            "icon": "bottle",
            "content": "<p>Miniatures are presented as described in the product details (for example, an original manufacturer miniature or a travel spray). Sizes and packaging may differ from full-size retail editions.</p>"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "price",
        "stock",
        "variants",
        "buy",
        "notes",
        "description",
        "specs",
        "shipping",
        "mini"
      ],
      "settings": {
        "viewer": "metafield"
      }
    },
    "recommendations": {
      "type": "product-recommendations",
      "settings": {
        "heading": "You may also love",
        "intent": "related",
        "limit": 8
      }
    }
  },
  "order": [
    "main",
    "recommendations"
  ]
}
