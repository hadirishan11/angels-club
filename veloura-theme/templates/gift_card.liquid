{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}" data-world="{{ settings.default_world }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex">
  {%- assign gc_value = gift_card.initial_value | money -%}
  <title>{{ 'gift_cards.issued.title' | t: value: gc_value, shop: shop.name }}</title>
  {% render 'css-variables' %}
  {{ 'veloura-base.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
  {{ content_for_header }}
</head>
<body>
  {% render 'svg-defs' %}
  <main class="section gift-card-page">
    <div class="container container--narrow text-center">
      {% render 'logo', variant: 'stacked', tone: 'theme', class: 'gift-card-page__logo' %}
      <p class="eyebrow eyebrow--lines">{{ 'gift_cards.issued.subtext' | t }}</p>
      <h1 class="h1">{{ 'gift_cards.issued.title' | t: value: gc_value, shop: shop.name }}</h1>
      {%- if gift_card.expired -%}
        {%- assign expired_on = gift_card.expires_on | date: '%Y-%m-%d' -%}
        <p class="form-message form-message--error">{{ 'gift_cards.issued.expired' | t: expiry: expired_on }}</p>
      {%- elsif gift_card.expires_on -%}
        {%- assign expiry = gift_card.expires_on | date: '%Y-%m-%d' -%}
        <p class="muted">{{ 'gift_cards.issued.expires_on' | t: expiry: expiry }}</p>
      {%- endif -%}
      <p class="h2">{{ gift_card.balance | money }}</p>
      <p>{{ 'gift_cards.issued.redeem' | t }}</p>
      <p class="h3" style="letter-spacing:.2em">{{ gift_card.code | format_code }}</p>
      <div id="QrCode" data-identifier="{{ gift_card.qr_identifier }}" style="display:inline-block;background:#fff;padding:12px;border-radius:8px" aria-label="{{ 'gift_cards.issued.qr_image_alt' | t }}"></div>
      <script>document.addEventListener('DOMContentLoaded',function(){var el=document.getElementById('QrCode');if(window.QRCode&&el){new QRCode(el,{text:el.dataset.identifier,width:140,height:140});}});</script>
      <p style="margin-top:28px">
        {%- if gift_card.pass_url -%}<a href="{{ gift_card.pass_url }}"><img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="{{ 'gift_cards.issued.add_to_apple_wallet' | t }}" style="display:inline-block"></a>{%- endif -%}
      </p>
      <p><a class="btn btn--primary" href="{{ shop.url }}">{{ 'gift_cards.issued.shop_link' | t }}</a> <button class="btn btn--outline" type="button" onclick="window.print()">{{ 'gift_cards.issued.print' | t }}</button></p>
    </div>
  </main>
</body>
</html>
