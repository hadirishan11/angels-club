<section class="section section--tight account-page">
  <div class="container account-auth"><div class="card-surface account-auth__panel">
    <h1 class="h2 text-center">{{ 'customer.reset.title' | t }}</h1>
    <p class="muted text-center">{{ 'customer.reset.text' | t }}</p>
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label for="ResetPass">{{ 'customer.reset.password' | t }}</label><input class="input" type="password" id="ResetPass" name="customer[password]" autocomplete="new-password"></div>
      <div class="field"><label for="ResetConfirm">{{ 'customer.reset.confirm' | t }}</label><input class="input" type="password" id="ResetConfirm" name="customer[password_confirmation]" autocomplete="new-password"></div>
      <button class="btn btn--primary btn--full" type="submit">{{ 'customer.reset.submit' | t }}</button>
    {%- endform -%}
  </div></div>
</section>
