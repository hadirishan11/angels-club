<section class="section section--tight account-page">
  <div class="container account-auth">
    <div class="card-surface account-auth__panel">
      <h1 class="h2 text-center">{{ 'customer.register.title' | t }}</h1>
      {%- form 'create_customer', novalidate: 'novalidate' -%}
        {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="field"><label for="RegFirst">{{ 'customer.register.first_name' | t }}</label><input class="input" id="RegFirst" name="customer[first_name]" autocomplete="given-name"></div>
        <div class="field"><label for="RegLast">{{ 'customer.register.last_name' | t }}</label><input class="input" id="RegLast" name="customer[last_name]" autocomplete="family-name"></div>
        <div class="field"><label for="RegEmail">{{ 'customer.register.email' | t }}</label><input class="input" type="email" id="RegEmail" name="customer[email]" autocomplete="email" required></div>
        <div class="field"><label for="RegPassword">{{ 'customer.register.password' | t }}</label><input class="input" type="password" id="RegPassword" name="customer[password]" autocomplete="new-password" required></div>
        <button class="btn btn--primary btn--full" type="submit">{{ 'customer.register.submit' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</section>
