{%- liquid
  # ---------------------------------------------------------------
  # Resolve the "world" (Noir / Rosé) for this page.
  # A forced world comes from the template suffix, the configured
  # Noir/Rosé collections, a collection/product metafield, or tags.
  # Otherwise the shopper's saved choice (localStorage) applies.
  # ---------------------------------------------------------------
  assign forced_world = ''
  if template.suffix contains 'noir'
    assign forced_world = 'noir'
  elsif template.suffix contains 'rose'
    assign forced_world = 'rose'
  endif

  if forced_world == '' and template.name == 'collection' and collection
    assign cw = collection.metafields.veloura.world.value | default: ''
    if cw == 'noir' or cw == 'rose'
      assign forced_world = cw
    elsif settings.noir_collection != blank and collection.handle == settings.noir_collection.handle
      assign forced_world = 'noir'
    elsif settings.rose_collection != blank and collection.handle == settings.rose_collection.handle
      assign forced_world = 'rose'
    endif
  endif

  if forced_world == '' and template.name == 'product' and product
    assign pw = product.metafields.veloura.world.value | default: ''
    assign ptags = product.tags | join: ',' | downcase
    if pw == 'noir' or pw == 'rose'
      assign forced_world = pw
    elsif ptags contains 'noir'
      assign forced_world = 'noir'
    elsif ptags contains 'rose' or ptags contains 'rosé'
      assign forced_world = 'rose'
    endif
  endif

  assign initial_world = forced_world | default: settings.default_world | default: 'noir'
  assign motion = settings.motion_level | default: 'full'
-%}
<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" data-world="{{ initial_world }}" data-world-forced="{{ forced_world }}" data-motion="{{ motion }}" data-template="{{ template.name }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="{% if initial_world == 'rose' %}{{ settings.rose_blush }}{% else %}{{ settings.noir_bg }}{% endif %}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 48, height: 48 }}">
    {%- else -%}
      <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
      <link rel="alternate icon" type="image/png" href="{{ 'favicon-48.png' | asset_url }}">
    {%- endif -%}
    <link rel="apple-touch-icon" href="{{ 'apple-touch-icon.png' | asset_url }}">

    {%- if settings.use_brand_fonts -%}
      {{ 'cinzel-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
      {{ 'montserrat-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags -%}{%- assign meta_tags = current_tags | join: ', ' %} &ndash; {{ 'general.meta.tags' | t: tags: meta_tags }}{%- endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    <script>
      /* Apply the saved world before first paint (no flash). */
      (function () {
        var d = document.documentElement;
        d.className = d.className.replace('no-js', 'js');
        try {
          var forced = d.getAttribute('data-world-forced');
          var saved = {% if settings.remember_world %}localStorage.getItem('veloura-world'){% else %}null{% endif %};
          if (!forced && (saved === 'noir' || saved === 'rose')) d.setAttribute('data-world', saved);
        } catch (e) {}
        if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) d.setAttribute('data-motion', 'reduced');
      })();
    </script>

    {% render 'css-variables' %}
    {{ 'veloura-base.css' | asset_url | stylesheet_tag }}
    {{ 'veloura-sections.css' | asset_url | stylesheet_tag }}

    <script>
      window.Veloura = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cartUpdate: {{ routes.cart_update_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }},
          productRecommendations: {{ routes.product_recommendations_url | json }},
          noir: {{ settings.noir_collection.url | default: routes.all_products_collection_url | json }},
          rose: {{ settings.rose_collection.url | default: routes.all_products_collection_url | json }}
        },
        assets: {
          three: {{ 'three.module.min.js' | asset_url | json }},
          v3d: {{ 'veloura-3d.js' | asset_url | json }},
          world3d: {{ 'veloura-world3d.js' | asset_url | json }}
        },
        settings: {
          cartType: {{ settings.cart_type | json }},
          enable3d: {{ settings.enable_3d | json }},
          particles: {{ settings.enable_particles | json }},
          tilt: {{ settings.enable_tilt | json }},
          worldTransition: {{ settings.enable_world_transition | json }},
          rememberWorld: {{ settings.remember_world | json }},
          predictiveSearch: {{ settings.predictive_search | json }},
          moneyFormat: {{ shop.money_format | json }}
        },
        strings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          adding: {{ 'products.product.adding' | t | json }},
          added: {{ 'products.product.added' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }},
          cartError: {{ 'cart.general.error' | t | json }},
          quantityError: {{ 'cart.general.quantity_error' | t | json }},
          worldNoir: {{ 'general.world.noir' | t | json }},
          worldRose: {{ 'general.world.rose' | t | json }},
          worldSwitched: {{ 'general.world.switched' | t | json }},
          searchNoResults: {{ 'general.search.no_results_short' | t | json }}
        }
      };
    </script>
    <script src="{{ 'veloura.js' | asset_url }}" defer></script>
    <script src="{{ 'veloura-v2.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }}{% if template.suffix %} template-suffix-{{ template.suffix | handle }}{% endif %}">
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>
    {% render 'svg-defs' %}
    <div class="world-atmosphere" aria-hidden="true"></div>

    {% sections 'header-group' %}

    <main id="MainContent" class="main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'cart-drawer' %}
    {%- if settings.mobile_tabbar -%}
      {% render 'mobile-tabbar' %}
    {%- endif -%}

    <div class="visually-hidden" role="status" aria-live="polite" id="v-live"></div>

    {%- comment -%} Organization structured data {%- endcomment -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": {{ shop.name | json }},
        "url": {{ request.origin | append: routes.root_url | json }}
        {%- assign socials = '' -%}
        {%- if settings.social_instagram != blank %}{% assign socials = socials | append: settings.social_instagram | append: '|' %}{% endif -%}
        {%- if settings.social_tiktok != blank %}{% assign socials = socials | append: settings.social_tiktok | append: '|' %}{% endif -%}
        {%- if settings.social_facebook != blank %}{% assign socials = socials | append: settings.social_facebook | append: '|' %}{% endif -%}
        {%- if settings.social_pinterest != blank %}{% assign socials = socials | append: settings.social_pinterest | append: '|' %}{% endif -%}
        {%- if socials != blank -%},
        "sameAs": {{ socials | split: '|' | json }}
        {%- endif %}
      }
    </script>
  </body>
</html>
