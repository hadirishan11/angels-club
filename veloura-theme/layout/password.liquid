<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" data-world="{{ settings.default_world }}" data-motion="{{ settings.motion_level }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
  <title>{{ shop.name }}</title>
  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
  {% render 'meta-tags' %}
  {% render 'css-variables' %}
  {{ 'veloura-base.css' | asset_url | stylesheet_tag }}
  {{ 'veloura-sections.css' | asset_url | stylesheet_tag }}
  <script>window.Veloura={routes:{},assets:{},strings:{},settings:{particles:{{ settings.enable_particles | json }},rememberWorld:false}};</script>
  <script src="{{ 'veloura.js' | asset_url }}" defer></script>
  {{ content_for_header }}
</head>
<body>
  {% render 'svg-defs' %}
  <div class="world-atmosphere" aria-hidden="true"></div>
  <main id="MainContent">{{ content_for_layout }}</main>
</body>
</html>
