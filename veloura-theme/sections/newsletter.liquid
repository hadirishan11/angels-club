<section class="section newsletter">
  {%- if settings.enable_particles -%}<div class="newsletter__atmo" data-atmosphere="auto" aria-hidden="true"></div>{%- endif -%}
  <div class="container container--narrow text-center newsletter__inner">
    <span class="divider-ornament" aria-hidden="true">{% render 'icon', name: 'sparkle' %}</span>
    <h2 class="h1" data-split>{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<div class="lede rte" data-reveal>{{ section.settings.text }}</div>{%- endif -%}
    {%- assign form_id = 'Newsletter-' | append: section.id -%}
    {%- form 'customer', id: form_id, class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success" role="status" tabindex="-1" autofocus>{{ 'general.newsletter.success' | t }}</p>
      {%- else -%}
        {%- if form.errors -%}<p class="form-message form-message--error" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
        <div class="newsletter__field" data-reveal>
          <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">{{ 'general.newsletter.label' | t }}</label>
          <input class="input" id="NewsletterEmail-{{ section.id }}" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'general.newsletter.placeholder' | t }}" aria-describedby="NewsletterConsent-{{ section.id }}">
          <button class="btn btn--primary" type="submit">{{ 'general.newsletter.submit' | t }}</button>
        </div>
        <p class="newsletter__consent muted" id="NewsletterConsent-{{ section.id }}">{% if section.settings.consent != blank %}{{ section.settings.consent }}{% else %}{{ 'general.newsletter.consent' | t }}{% endif %}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "class": "section-newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the Veloura circle" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>New arrivals, discovery sets and private previews — delivered with restraint.</p>" },
    { "type": "text", "id": "consent", "label": "Consent text", "default": "By subscribing you agree to receive marketing emails from Veloura. You can unsubscribe at any time. See our privacy policy.", "info": "Canada's anti-spam law (CASL) requires clear consent wording. Review with your advisor." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
