<section class="dual-hero dual-hero--password" style="--dual-min-h: 100svh">
  <div class="dual-panel dual-panel--noir" data-dual-panel="noir"><div class="dual-panel__bg" aria-hidden="true"></div><div class="dual-panel__atmo" data-atmosphere="noir" aria-hidden="true"></div></div>
  <div class="dual-panel dual-panel--rose" data-dual-panel="rose"><div class="dual-panel__bg" aria-hidden="true"></div><div class="dual-panel__atmo" data-atmosphere="rose" aria-hidden="true"></div></div>
  <div class="password__center">
    {% render 'logo', variant: 'full', tone: 'signature', class: 'vl-logo--animated dual-hero__logo' %}
    <h1 class="h2" style="color:#F5F2EA">{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}<p style="color:#F5F2EA">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer', class: 'password__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter, prelaunch">
      {%- if form.posted_successfully? -%}<p class="form-message form-message--success">{{ 'general.newsletter.success' | t }}</p>{%- else -%}
        <div class="newsletter__field"><label class="visually-hidden" for="PwEmail">{{ 'general.newsletter.label' | t }}</label><input class="input" id="PwEmail" type="email" name="contact[email]" required placeholder="{{ 'general.newsletter.placeholder' | t }}"><button class="btn btn--primary" type="submit">{{ 'general.newsletter.submit' | t }}</button></div>
      {%- endif -%}
    {%- endform -%}
    <details class="password__login">
      <summary>{{ 'general.password.enter_password' | t }}</summary>
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}<p class="form-message form-message--error">{{ form.errors | default_errors }}</p>{%- endif -%}
        <div class="newsletter__field"><label class="visually-hidden" for="PwPass">{{ 'general.password.password' | t }}</label><input class="input" id="PwPass" type="password" name="password" autocomplete="current-password"><button class="btn btn--outline" type="submit">{{ 'general.password.submit' | t }}</button></div>
      {%- endform -%}
      <p style="font-size:.8rem;color:#F5F2EA">{{ 'general.password.owner' | t }} <a href="/admin">{{ 'general.password.login' | t }}</a></p>
    </details>
  </div>
</section>

{% schema %}
{ "name": "Password page", "class": "section-password", "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Iconic Scents. Miniature Luxury. Opening soon." } ] }
{% endschema %}
