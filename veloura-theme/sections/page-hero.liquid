<section class="page-hero">
  {%- if settings.enable_particles -%}<div class="page-hero__atmo" data-atmosphere="auto" aria-hidden="true"></div>{%- endif -%}
  <div class="container text-center page-hero__inner">
    {%- if section.settings.show_logo -%}{% render 'logo', variant: 'mark', tone: 'theme', class: 'page-hero__mark vl-logo--animated' %}{%- endif -%}
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--lines">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h1 class="h-display" data-split>{{ section.settings.heading | default: page.title }}</h1>
    {%- if section.settings.text != blank -%}<div class="lede rte" data-reveal>{{ section.settings.text }}</div>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Page hero",
  "class": "section-page-hero",
  "settings": [
    { "type": "checkbox", "id": "show_logo", "label": "Show V monogram", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Veloura" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave empty to use the page title." },
    { "type": "richtext", "id": "text", "label": "Text" }
  ],
  "presets": [{ "name": "Page hero" }]
}
{% endschema %}
