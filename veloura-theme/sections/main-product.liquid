{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign mf = product.metafields.veloura
  assign ptags = product.tags | join: ',' | downcase
  assign pworld = mf.world.value | default: ''
  if pworld == ''
    if ptags contains 'rose' or ptags contains 'rosé'
      assign pworld = 'rose'
    elsif ptags contains 'noir'
      assign pworld = 'noir'
    else
      assign pworld = 'auto'
    endif
  endif

  assign bottle_shape = mf.bottle_shape.value | default: ''
  assign liquid_color = mf.liquid_color.value | default: ''
  assign glass_color = mf.glass_color.value | default: ''
  assign cap_style = mf.cap_style.value | default: ''
  assign product_form_id = 'ProductForm-' | append: section.id
-%}
{%- capture bottle_json -%}{"shape":{{ bottle_shape | json }},"liquid":{{ liquid_color | json }},"glass":{{ glass_color | json }},"cap":{{ cap_style | json }}}{%- endcapture -%}
{%- assign show_viewer = false -%}
{%- if section.settings.viewer == 'always' -%}{%- assign show_viewer = true -%}{%- endif -%}
{%- if section.settings.viewer == 'no_images' and product.media.size == 0 -%}{%- assign show_viewer = true -%}{%- endif -%}
{%- if section.settings.viewer == 'metafield' and bottle_shape != blank -%}{%- assign show_viewer = true -%}{%- endif -%}
{%- assign slide_count = product.media.size -%}
{%- if show_viewer or product.media.size == 0 -%}{%- assign slide_count = slide_count | plus: 1 -%}{%- endif -%}

{{ 'veloura-product.css' | asset_url | stylesheet_tag }}

<section class="product" data-product data-section="{{ section.id }}">
  <div class="container product__grid">
    {%- comment -%} ---------------- Gallery ---------------- {%- endcomment -%}
    <div class="product__gallery">
      <div class="gallery">
        <ul class="gallery__track" data-gallery-track role="list" tabindex="0" aria-label="{{ product.title | escape }}">
          {%- for media in product.media -%}
            <li class="gallery__slide gallery__slide--{{ media.media_type }}" data-media-id="{{ media.id }}" aria-label="{{ 'accessibility.slide' | t: index: forloop.index, count: slide_count }}">
              {%- case media.media_type -%}
                {%- when 'image' -%}
                  {%- liquid
                    assign loading = 'lazy'
                    if forloop.first
                      assign loading = 'eager'
                    endif
                  -%}
                  {{ media | image_url: width: 1600 | image_tag: loading: loading, widths: '400, 600, 800, 1000, 1300, 1600', sizes: '(min-width: 990px) 52vw, 100vw', alt: media.alt | default: product.title, data-fly-source: '' }}
                {%- when 'model' -%}
                  {{ media | model_viewer_tag: image_size: '1200x', reveal: 'interaction', toggleable: true, data-model-id: media.id }}
                {%- when 'video' -%}
                  {{ media | video_tag: controls: true, playsinline: true, preload: 'none', image_size: '1200x' }}
                {%- when 'external_video' -%}
                  {{ media | external_video_tag: loading: 'lazy' }}
              {%- endcase -%}
            </li>
          {%- endfor -%}
          {%- if show_viewer or product.media.size == 0 -%}
            <li class="gallery__slide gallery__slide--viewer" data-media-id="viewer" aria-label="{{ 'products.product.view_3d' | t }}">
              <div class="viewer v3d" {% if settings.enable_3d %}data-v3d="viewer" data-v3d-world="{{ pworld }}" data-v3d-bottle="{{ bottle_json | escape }}" tabindex="0" role="img" aria-label="{{ 'accessibility.viewer_label' | t }}"{% endif %}>
                <div class="viewer__halo" aria-hidden="true"></div>
                <div class="v3d__fallback viewer__fallback">
                  {% render 'placeholder-bottle', shape: bottle_shape, label: product.title %}
                </div>
                <span class="v3d__hint">{% render 'icon', name: 'rotate' %}{{ 'accessibility.rotate_hint' | t }}</span>
              </div>
            </li>
          {%- endif -%}
        </ul>
        {%- if slide_count > 1 -%}
          <div class="gallery__dots" aria-hidden="true">
            {%- for i in (1..slide_count) -%}<button type="button" tabindex="-1" data-gallery-dot data-index="{{ forloop.index0 }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"></button>{%- endfor -%}
          </div>
          <ul class="gallery__thumbs" role="list">
            {%- for media in product.media -%}
              <li><button type="button" class="gallery__thumb" data-gallery-thumb data-index="{{ forloop.index0 }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="{{ 'products.product.media' | t: index: forloop.index }}">
                {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
              </button></li>
            {%- endfor -%}
            {%- if show_viewer or product.media.size == 0 -%}
              <li><button type="button" class="gallery__thumb gallery__thumb--3d" data-gallery-thumb data-index="{{ product.media.size }}" aria-label="{{ 'products.product.view_3d' | t }}">3D</button></li>
            {%- endif -%}
          </ul>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} ---------------- Info ---------------- {%- endcomment -%}
    <div class="product__info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}

          {%- when 'vendor' -%}
            {%- if product.vendor != blank -%}<a class="product__vendor" href="{{ product.vendor | url_for_vendor }}" {{ block.shopify_attributes }}>{{ product.vendor }}</a>{%- endif -%}

          {%- when 'title' -%}
            <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title }}</h1>
            {%- if mf.concentration != blank or mf.bottle_size != blank -%}
              <p class="product__subtitle">{{ mf.concentration | metafield_text }}{% if mf.concentration != blank and mf.bottle_size != blank %} · {% endif %}{{ mf.bottle_size | metafield_text }}</p>
            {%- endif -%}

          {%- when 'price' -%}
            <div class="product__price" {{ block.shopify_attributes }}>
              <div data-price>{% render 'price', product: product, variant: current_variant %}</div>
              <p class="product__tax muted">
                {%- if cart.taxes_included -%}{{ 'products.product.taxes_included' | t }}{%- else -%}{{ 'products.product.shipping_calculated' | t }}{%- endif -%}
              </p>
            </div>

          {%- when 'stock' -%}
            <p class="product__stock" data-stock data-state="{% if current_variant.available %}in{% else %}out{% endif %}"
              data-in-stock="{{ 'products.product.in_stock' | t }}" data-out-stock="{{ 'products.product.out_of_stock' | t }}" {{ block.shopify_attributes }}>
              {%- if current_variant.available -%}{{ 'products.product.in_stock' | t }}{%- else -%}{{ 'products.product.out_of_stock' | t }}{%- endif -%}
            </p>

          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              <div class="variant-picker" {{ block.shopify_attributes }}>
                {%- for option in product.options_with_values -%}
                  {%- assign option_index = forloop.index0 -%}
                  <fieldset class="variant-picker__group">
                    <legend>{{ option.name }}: <span data-selected-value="{{ option_index }}">{{ option.selected_value }}</span></legend>
                    <div class="swatches">
                      {%- for value in option.values -%}
                        <label class="swatch">
                          <input type="radio" class="visually-hidden" name="{{ section.id }}-{{ option.name | handle }}" value="{{ value | escape }}" data-option-index="{{ option_index }}" {% if option.selected_value == value %}checked{% endif %}>
                          <span>{{ value }}</span>
                        </label>
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endfor -%}
              </div>
            {%- endunless -%}

          {%- when 'buy_buttons' -%}
            <div class="product__buy" {{ block.shopify_attributes }}>
              {%- form 'product', product, id: product_form_id, data-product-form: '', novalidate: 'novalidate' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}">
                <div class="product__buy-row">
                  <div class="qty">
                    <button type="button" data-qty-btn="minus" aria-label="{{ 'products.product.decrease' | t: product: product.title | escape }}">{% render 'icon', name: 'minus' %}</button>
                    <label class="visually-hidden" for="Quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
                    <input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1" step="1" inputmode="numeric">
                    <button type="button" data-qty-btn="plus" aria-label="{{ 'products.product.increase' | t: product: product.title | escape }}">{% render 'icon', name: 'plus' %}</button>
                  </div>
                  <button type="submit" class="btn btn--primary product__add" data-add-button {% unless current_variant.available %}disabled aria-disabled="true"{% endunless %}>
                    <span data-add-label>{%- if current_variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}</span>
                  </button>
                </div>
                <p class="form-message form-message--error" data-form-error role="alert" hidden></p>
                {%- if block.settings.dynamic_checkout -%}<div class="product__dynamic">{{ form | payment_button }}</div>{%- endif -%}
              {%- endform -%}
              <ul class="product__assurances" role="list">
                <li>{% render 'icon', name: 'lock' %} {{ 'cart.general.secure' | t }}</li>
                <li>{% render 'icon', name: 'gift' %} {{ 'products.product.authenticity' | t }}</li>
              </ul>
            </div>

          {%- when 'notes' -%}
            {%- if mf.top_notes != blank or mf.heart_notes != blank or mf.base_notes != blank or mf.fragrance_family != blank -%}
              <div class="notes" {{ block.shopify_attributes }}>
                <h2 class="notes__title">{{ 'products.product.notes' | t }}</h2>
                {%- if mf.fragrance_family != blank -%}<p class="notes__family"><span>{{ 'products.product.family' | t }}</span> {{ mf.fragrance_family | metafield_text }}</p>{%- endif -%}
                <div class="notes__pyramid">
                  {%- if mf.top_notes != blank -%}<div class="notes__tier notes__tier--top"><span class="notes__label">{{ 'products.product.top_notes' | t }}</span><span>{{ mf.top_notes | metafield_text }}</span></div>{%- endif -%}
                  {%- if mf.heart_notes != blank -%}<div class="notes__tier notes__tier--heart"><span class="notes__label">{{ 'products.product.heart_notes' | t }}</span><span>{{ mf.heart_notes | metafield_text }}</span></div>{%- endif -%}
                  {%- if mf.base_notes != blank -%}<div class="notes__tier notes__tier--base"><span class="notes__label">{{ 'products.product.base_notes' | t }}</span><span>{{ mf.base_notes | metafield_text }}</span></div>{%- endif -%}
                </div>
              </div>
            {%- endif -%}

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="product__description rte" {{ block.shopify_attributes }}>{{ product.description }}</div>
            {%- endif -%}

          {%- when 'specs' -%}
            <dl class="specs" {{ block.shopify_attributes }}>
              {%- if product.vendor != blank -%}<div><dt>{{ 'products.product.brand' | t }}</dt><dd>{{ product.vendor }}</dd></div>{%- endif -%}
              {%- if mf.bottle_size != blank -%}<div><dt>{{ 'products.product.size' | t }}</dt><dd>{{ mf.bottle_size | metafield_text }}</dd></div>{%- endif -%}
              {%- if mf.concentration != blank -%}<div><dt>{{ 'products.product.concentration' | t }}</dt><dd>{{ mf.concentration | metafield_text }}</dd></div>{%- endif -%}
              {%- if mf.fragrance_family != blank -%}<div><dt>{{ 'products.product.family' | t }}</dt><dd>{{ mf.fragrance_family | metafield_text }}</dd></div>{%- endif -%}
              {%- if current_variant.sku != blank and block.settings.show_sku -%}<div><dt>{{ 'products.product.sku' | t }}</dt><dd>{{ current_variant.sku }}</dd></div>{%- endif -%}
            </dl>

          {%- when 'collapsible' -%}
            <details class="accordion__item" {{ block.shopify_attributes }}>
              <summary><span>{% render 'icon', name: block.settings.icon %} {{ block.settings.heading }}</span>{% render 'icon', name: 'plus' %}</summary>
              <div class="accordion__content rte">
                {{ block.settings.content }}
                {%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- endif -%}
              </div>
            </details>

          {%- when 'text' -%}
            <div class="rte muted" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  {%- if settings.sticky_atc -%}
    <div class="sticky-atc" data-sticky-atc aria-hidden="true">
      <div class="sticky-atc__info">
        <span class="sticky-atc__title">{{ product.title }}</span>
        <span class="sticky-atc__price" data-sticky-price>{{ current_variant.price | money }}</span>
      </div>
      <button type="button" class="btn btn--primary btn--small" data-sticky-add {% unless current_variant.available %}disabled aria-disabled="true"{% endunless %}>
        <span data-add-label>{%- if current_variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}</span>
      </button>
    </div>
  {%- endif -%}

  <script type="application/json" data-product-json>
    {
      "id": {{ product.id }},
      "variants": [
        {%- for v in product.variants -%}
          { "id": {{ v.id }}, "options": {{ v.options | json }}, "available": {{ v.available | json }}, "price": {{ v.price }}, "compare_at_price": {{ v.compare_at_price | default: 0 }}, "featured_media": {% if v.featured_media %}{ "id": {{ v.featured_media.id }} }{% else %}null{% endif %} }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
</section>

{%- comment -%} Product structured data {%- endcomment -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {%- if product.featured_image -%}"image": [{{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}],{%- endif -%}
    "description": {{ product.description | strip_html | strip | truncate: 500 | json }},
    {%- if current_variant.sku != blank -%}"sku": {{ current_variant.sku | json }},{%- endif -%}
    "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type": "Offer",
          {%- if variant.sku != blank -%}"sku": {{ variant.sku | json }},{%- endif -%}
          "availability": "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "price": {{ variant.price | divided_by: 100.00 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "url": {{ request.origin | append: variant.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

{% schema %}
{
  "name": "Product information",
  "class": "section-main-product",
  "settings": [
    { "type": "select", "id": "viewer", "label": "Interactive 3D bottle", "options": [
      { "value": "metafield", "label": "When bottle shape metafield is set" },
      { "value": "no_images", "label": "Only when product has no images" },
      { "value": "always", "label": "Always (as last gallery slide)" },
      { "value": "never", "label": "Never" }
    ], "default": "metafield", "info": "The viewer shows an illustrative, label-free Veloura bottle. Upload real 3D models (GLB) to product media to show the actual product in 3D." }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "vendor", "name": "Brand", "limit": 1 },
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "price", "name": "Price", "limit": 1 },
    { "type": "stock", "name": "Availability", "limit": 1 },
    { "type": "variant_picker", "name": "Variant picker", "limit": 1 },
    { "type": "buy_buttons", "name": "Buy buttons", "limit": 1, "settings": [
      { "type": "checkbox", "id": "dynamic_checkout", "label": "Show dynamic checkout buttons", "default": true, "info": "Shows the express payment methods you enable in Shopify (e.g. Shop Pay, Apple Pay, Google Pay)." }
    ] },
    { "type": "notes", "name": "Fragrance notes", "limit": 1 },
    { "type": "description", "name": "Description", "limit": 1 },
    { "type": "specs", "name": "Specifications", "limit": 1, "settings": [ { "type": "checkbox", "id": "show_sku", "label": "Show SKU", "default": false } ] },
    { "type": "collapsible", "name": "Collapsible tab", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping & returns" },
      { "type": "select", "id": "icon", "label": "Icon", "options": [ { "value": "truck", "label": "Delivery" }, { "value": "return", "label": "Returns" }, { "value": "gift", "label": "Gift" }, { "value": "bottle", "label": "Bottle" }, { "value": "sparkle", "label": "Sparkle" } ], "default": "truck" },
      { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Shipping within Canada. Rates and delivery estimates are shown at checkout. See our shipping and returns policies for full details.</p>" },
      { "type": "page", "id": "page", "label": "Page content (optional)" }
    ] },
    { "type": "text", "name": "Text", "settings": [ { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Miniature format. Please note that sizes, packaging and batch details may differ from full-size retail editions.</p>" } ] }
  ]
}
{% endschema %}
