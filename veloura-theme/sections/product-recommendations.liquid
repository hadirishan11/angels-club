<section class="section section--tight product-recs">
  <div class="container">
    <div class="section-header section-header--split">
      <h2 class="h2" style="margin:0">{{ section.settings.heading }}</h2>
      <div class="carousel__controls">
        <button class="carousel__btn carousel__btn--prev" type="button" data-carousel-prev aria-label="{{ 'accessibility.previous' | t }}">{% render 'icon', name: 'arrow' %}</button>
        <button class="carousel__btn" type="button" data-carousel-next aria-label="{{ 'accessibility.next' | t }}">{% render 'icon', name: 'arrow' %}</button>
      </div>
    </div>
    <div class="carousel" data-carousel>
      <div data-recommendations data-section-id="{{ section.id }}" data-product-id="{{ product.id }}" data-limit="{{ section.settings.limit }}" data-intent="{{ section.settings.intent }}">
        {%- if recommendations.performed and recommendations.products_count > 0 -%}
          <ul class="carousel__track" role="list">
            {%- for rec in recommendations.products -%}
              <li>{% render 'product-card', card_product: rec, index: forloop.index0 %}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product recommendations",
  "class": "section-product-recs",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also love" },
    { "type": "select", "id": "intent", "label": "Type", "options": [ { "value": "related", "label": "Related fragrances" }, { "value": "complementary", "label": "Complementary (set in Search & Discovery app)" } ], "default": "related" },
    { "type": "range", "id": "limit", "label": "Maximum products", "min": 2, "max": 10, "step": 1, "default": 8 }
  ]
}
{% endschema %}
