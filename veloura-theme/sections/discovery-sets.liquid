{%- liquid
  assign c = section.settings.collection | default: settings.discovery_collection
  assign p = section.settings.product
-%}
<section class="section section--band discovery">
  <div class="discovery__texture" aria-hidden="true"></div>
  <div class="container discovery__grid">
    <div class="discovery__text">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h1" data-split>{{ section.settings.heading }}</h2>
      <div class="rte discovery__copy" data-reveal>{{ section.settings.text }}</div>
      {%- if p != blank -%}
        <div class="discovery__product" data-reveal data-product>
          <div>
            <p class="discovery__product-title">{{ p.title }}</p>
            {% render 'price', product: p %}
          </div>
          {%- if p.available and p.has_only_default_variant -%}
            {%- form 'product', p, data-product-form: '' -%}
              <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
              <button class="btn btn--primary" type="submit" data-add-button><span data-add-label>{{ 'products.product.add_to_cart' | t }}</span></button>
            {%- endform -%}
          {%- else -%}
            <a class="btn btn--primary" href="{{ p.url }}">{{ 'general.shop_now' | t }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
      {%- if section.settings.cta != blank -%}
        <a class="btn btn--outline" href="{{ c.url | default: routes.all_products_collection_url }}" data-reveal>{{ section.settings.cta }} {% render 'icon', name: 'arrow' %}</a>
      {%- endif -%}
    </div>
    <div class="discovery__visual" data-reveal="right">
      <div class="discovery__float">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '500, 800, 1100, 1400', sizes: '(min-width: 990px) 55vw, 100vw', alt: section.settings.image.alt | default: section.settings.heading }}
        {%- else -%}
          <img class="world-art world-art--noir" src="{{ 'veloura-discovery-noir.webp' | asset_url }}" width="1200" height="750" alt="{{ section.settings.art_alt | escape }}" loading="lazy" decoding="async">
          <img class="world-art world-art--rose" src="{{ 'veloura-discovery-rose.webp' | asset_url }}" width="1200" height="750" alt="{{ section.settings.art_alt | escape }}" loading="lazy" decoding="async">
        {%- endif -%}
      </div>
    </div>
  </div>
  {%- if section.settings.show_products and c != blank and c.products_count > 0 -%}
    <div class="container discovery__products">
      <ul class="grid grid--3" role="list" data-reveal-group>
        {%- for product in c.products limit: 3 -%}<li>{% render 'product-card', card_product: product, index: forloop.index0 %}</li>{%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Discovery sets",
  "class": "section-discovery",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Discovery sets" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your signature" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Curated sets of miniature fragrances, presented in a keepsake Veloura case. Explore a family of scents, then return for the one you can't live without.</p>" },
    { "type": "collection", "id": "collection", "label": "Discovery sets collection", "info": "Defaults to the collection in Theme settings." },
    { "type": "checkbox", "id": "show_products", "label": "Show three sets from the collection", "default": true },
    { "type": "product", "id": "product", "label": "Featured set (optional)" },
    { "type": "text", "id": "cta", "label": "Button label", "default": "Shop discovery sets" },
    { "type": "image_picker", "id": "image", "label": "Image (optional)" },
    { "type": "text", "id": "art_alt", "label": "Built-in image alt text", "default": "A Veloura discovery case holding five miniature bottles" }
  ],
  "presets": [{ "name": "Discovery sets" }]
}
{% endschema %}
