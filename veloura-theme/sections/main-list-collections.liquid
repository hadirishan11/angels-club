<section class="section">
  <div class="container">
    <div class="section-header text-center"><p class="eyebrow eyebrow--lines">{{ shop.name }}</p><h1 class="h1" data-split>{{ section.settings.heading }}</h1></div>
    <ul class="grid grid--3" role="list" data-reveal-group>
      {%- for c in collections -%}
        {%- if c.products_count > 0 -%}
          <li data-reveal>
            <a class="collection-tile" href="{{ c.url }}" data-tilt>
              <span class="collection-tile__media">
                {%- if c.featured_image -%}{{ c.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 600, 900', sizes: '(min-width: 750px) 30vw, 50vw', alt: '' }}{%- else -%}{% render 'placeholder-bottle', shape: 'round' %}{%- endif -%}
              </span>
              <span class="collection-tile__title">{{ c.title }}</span>
              <span class="muted">{{ 'collections.general.products_count' | t: count: c.products_count }}</span>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "class": "section-list-collections",
  "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" } ]
}
{% endschema %}
