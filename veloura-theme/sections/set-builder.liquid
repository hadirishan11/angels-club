{%- assign source = section.settings.collection | default: collections.all -%}
<section class="section set-builder" data-set-builder data-sizes="{% if section.settings.allow_five %}3,5{% else %}3{% endif %}" data-discount-note="{{ section.settings.discount_note | escape }}">
  <div class="container">
    <div class="set-builder__intro">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h1 class="h1">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}<div class="lede rte">{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <div class="set-builder__grid">
      <div class="set-builder__tray">
        <div class="tray" data-tray aria-label="Your discovery case">
          <img src="{{ 'veloura-discovery-noir.webp' | asset_url }}" alt="" class="tray__fallback world-art world-art--noir" loading="lazy" width="1200" height="750">
          <img src="{{ 'veloura-discovery-rose.webp' | asset_url }}" alt="" class="tray__fallback world-art world-art--rose" loading="lazy" width="1200" height="750">
        </div>
        <div class="tray__slots" data-slots></div>
        <div class="sum">
          <div><div class="sum__price" data-total></div><span class="muted" data-sum-note></span></div>
          <button class="btn btn--primary" type="button" data-add-set disabled>{% render 'icon', name: 'gift' %} {{ section.settings.button }}</button>
        </div>
      </div>
      <div>
        <div class="set-builder__filters">
          <div class="chips" role="group" aria-label="Set size">
            <button class="chip" type="button" data-size="3" aria-pressed="true">Set of 3</button>
            {%- if section.settings.allow_five -%}<button class="chip" type="button" data-size="5" aria-pressed="false">Set of 5</button>{%- endif -%}
          </div>
          <div class="chips" role="group" aria-label="World">
            <button class="chip" type="button" data-filter="" aria-pressed="true">All</button>
            <button class="chip" type="button" data-filter="noir" aria-pressed="false">Noir</button>
            <button class="chip" type="button" data-filter="rose" aria-pressed="false">Rosé</button>
          </div>
        </div>
        <div class="pick-list" data-picks></div>
      </div>
    </div>
  </div>
  <script type="application/json" data-builder-products>{% render 'product-data-json', products: source.products, limit: 60 %}</script>
</section>

{% schema %}
{
  "name": "Build a discovery set",
  "class": "section-set-builder",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Discovery sets" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build your own set" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Choose three or five miniatures. They arrive together in a signature Veloura case.</p>" },
    { "type": "collection", "id": "collection", "label": "Products shoppers can choose", "info": "Defaults to all products." },
    { "type": "checkbox", "id": "allow_five", "label": "Offer a set of 5", "default": true },
    { "type": "text", "id": "button", "label": "Button label", "default": "Add set to bag" },
    { "type": "text", "id": "discount_note", "label": "Message when the set is complete", "default": "Your case is ready.", "info": "To give a set price, create an automatic discount in Shopify (e.g. 'Buy 3 from the Discovery collection, get X% off') and describe it here." }
  ],
  "presets": [{ "name": "Build a discovery set" }]
}
{% endschema %}
