<section class="section section--tight">
  <div class="container">
    <div class="section-header text-center"><p class="eyebrow eyebrow--lines">{{ shop.name }}</p><h1 class="h1" data-split>{{ blog.title }}</h1></div>
    {%- paginate blog.articles by 9 -%}
      <ul class="grid grid--3" role="list" data-reveal-group>
        {%- for article in blog.articles -%}
          <li data-reveal>
            <a class="article-card" href="{{ article.url }}">
              <span class="article-card__media">{%- if article.image -%}{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 600, 900', sizes: '(min-width: 750px) 30vw, 92vw', alt: article.image.alt | default: article.title }}{%- else -%}{% render 'placeholder-bottle', shape: 'round' %}{%- endif -%}</span>
              <span class="card__vendor">{{ article.published_at | time_tag: format: 'date' }}</span>
              <span class="card__title">{{ article.title }}</span>
              <span class="muted">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Blog posts", "class": "section-main-blog", "settings": [] }
{% endschema %}
