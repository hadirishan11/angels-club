<section class="section page-hero">
  {%- if settings.enable_particles -%}<div class="page-hero__atmo" data-atmosphere="auto" aria-hidden="true"></div>{%- endif -%}
  <div class="container text-center page-hero__inner">
    {% render 'logo', variant: 'mark', tone: 'theme', class: 'page-hero__mark vl-logo--animated' %}
    <p class="eyebrow eyebrow--lines">404</p>
    <h1 class="h-display">{{ 'general.404.title' | t }}</h1>
    <p class="lede">{{ 'general.404.subtitle' | t }}</p>
    <a class="btn btn--primary" href="{{ routes.root_url }}">{{ 'general.404.link' | t }}</a>
  </div>
</section>

{% schema %}
{ "name": "404", "class": "section-404", "settings": [] }
{% endschema %}
