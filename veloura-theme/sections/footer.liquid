<footer class="footer" style="--footer-cols: {{ section.blocks.size | minus: 1 | at_least: 1 }}">
  <div class="container">
    <div class="footer__top">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'brand' -%}
            <div class="footer__brand" {{ block.shopify_attributes }}>
              {% render 'logo', variant: 'stacked', tone: 'theme' %}
              {%- if block.settings.text != blank -%}<div class="muted">{{ block.settings.text }}</div>{%- endif -%}
              {%- if block.settings.contact != blank -%}<div class="muted" style="margin-top:12px">{{ block.settings.contact }}</div>{%- endif -%}
              {% render 'social-links' %}
            </div>
          {%- when 'menu' -%}
            <div {{ block.shopify_attributes }}>
              <h2>{{ block.settings.heading | default: block.settings.menu.title }}</h2>
              <ul role="list">
                {%- for link in block.settings.menu.links -%}
                  <li><a class="link-underline" href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            </div>
          {%- when 'text' -%}
            <div {{ block.shopify_attributes }}>
              <h2>{{ block.settings.heading }}</h2>
              <div class="muted rte">{{ block.settings.text }}</div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <div class="footer__localization">
        {%- if section.settings.show_country and localization.available_countries.size > 1 -%}
          {%- form 'localization', data-localization-form: '' -%}
            <label class="visually-hidden" for="FooterCountry">{{ 'general.localization.country' | t }}</label>
            <select class="select" id="FooterCountry" name="country_code">
              {%- for country in localization.available_countries -%}
                <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})</option>
              {%- endfor -%}
            </select>
            <noscript><button class="btn btn--small" type="submit">{{ 'collections.general.apply' | t }}</button></noscript>
          {%- endform -%}
        {%- endif -%}
        {%- if section.settings.show_language and localization.available_languages.size > 1 -%}
          {%- form 'localization', data-localization-form: '' -%}
            <label class="visually-hidden" for="FooterLanguage">{{ 'general.localization.language' | t }}</label>
            <select class="select" id="FooterLanguage" name="locale_code">
              {%- for language in localization.available_languages -%}
                <option value="{{ language.iso_code }}" lang="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>{{ language.endonym_name | capitalize }}</option>
              {%- endfor -%}
            </select>
            <noscript><button class="btn btn--small" type="submit">{{ 'collections.general.apply' | t }}</button></noscript>
          {%- endform -%}
        {%- endif -%}
      </div>

      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="payment-icons" role="list" aria-label="{{ 'general.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}

      <ul class="footer__policies" role="list" aria-label="{{ 'general.policies' | t }}">
        {%- for policy in shop.policies -%}
          {%- if policy != blank -%}<li><a class="link-underline" href="{{ policy.url }}">{{ policy.title }}</a></li>{%- endif -%}
        {%- endfor -%}
      </ul>
      {%- assign year = 'now' | date: '%Y' -%}
      <p style="margin:0">{{ 'general.copyright' | t: year: year, shop: shop.name }}</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "max_blocks": 5,
  "settings": [
    { "type": "checkbox", "id": "show_country", "label": "Show country / currency selector", "default": true, "info": "Requires more than one market in Settings › Markets." },
    { "type": "checkbox", "id": "show_language", "label": "Show language selector", "default": true, "info": "Publish French in Settings › Languages to enable." },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true }
  ],
  "blocks": [
    { "type": "brand", "name": "Brand", "limit": 1, "settings": [
      { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Iconic scents. Miniature luxury. A Canadian boutique of curated miniature designer fragrances.</p>" },
      { "type": "richtext", "id": "contact", "label": "Contact details", "default": "<p>hello@[your-domain].ca</p>" }
    ] },
    { "type": "menu", "name": "Menu", "settings": [
      { "type": "text", "id": "heading", "label": "Heading" },
      { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
    ] },
    { "type": "text", "name": "Text", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Care" },
      { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Questions about a fragrance or your order? We're here to help.</p>" }
    ] }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
