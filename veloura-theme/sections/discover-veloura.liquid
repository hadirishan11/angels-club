<section class="section discover" id="discover-{{ section.id }}">
  <div class="container discover__grid">
    <div class="discover__text">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h1" data-split>{{ section.settings.heading }}</h2>
      <div class="lede rte" data-reveal>{{ section.settings.text }}</div>
      {%- if section.blocks.size > 0 -%}
        <ul class="pillars" role="list" data-reveal-group>
          {%- for block in section.blocks -%}
            <li class="pillar" data-reveal {{ block.shopify_attributes }}>
              <span class="pillar__icon">{% render 'icon', name: block.settings.icon %}</span>
              <div>
                <h3 class="pillar__title">{{ block.settings.title }}</h3>
                <p class="muted">{{ block.settings.text }}</p>
              </div>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.cta != blank -%}
        <a class="btn btn--outline" href="{{ section.settings.link | default: routes.all_products_collection_url }}" data-reveal>{{ section.settings.cta }} {% render 'icon', name: 'arrow' %}</a>
      {%- endif -%}
    </div>

    <div class="discover__viewer" data-reveal="scale">
      <div class="viewer v3d" {% if section.settings.enable_3d %}data-v3d="viewer" data-v3d-world="auto" tabindex="0" role="img" aria-label="{{ 'accessibility.viewer_label' | t }}"{% endif %}>
        <div class="viewer__halo" aria-hidden="true"></div>
        <div class="v3d__fallback viewer__fallback">
          <img class="world-art world-art--noir" src="{{ 'veloura-bottle-noir.webp' | asset_url }}" width="674" height="1069" alt="" loading="lazy" decoding="async">
          <img class="world-art world-art--rose" src="{{ 'veloura-bottle-rose.webp' | asset_url }}" width="670" height="1067" alt="" loading="lazy" decoding="async">
        </div>
        <span class="v3d__hint">{% render 'icon', name: 'rotate' %}{{ 'accessibility.rotate_hint' | t }}</span>
      </div>
      {%- if section.settings.caption != blank -%}<p class="viewer__caption">{{ section.settings.caption }}</p>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Discover Veloura",
  "class": "section-discover",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Discover Veloura" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Iconic scents, beautifully miniature" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Veloura curates miniature editions of the world's most celebrated designer fragrances. Explore a signature scent before committing to a full bottle, travel with your favourites, or build a wardrobe of fragrances for every mood.</p>" },
    { "type": "text", "id": "cta", "label": "Button label", "default": "Shop all perfumes" },
    { "type": "url", "id": "link", "label": "Button link" },
    { "type": "checkbox", "id": "enable_3d", "label": "Interactive 3D bottle", "default": true },
    { "type": "text", "id": "caption", "label": "Viewer caption", "default": "Illustrative Veloura bottle — drag to explore" }
  ],
  "blocks": [
    { "type": "pillar", "name": "Pillar", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "options": [ { "value": "bottle", "label": "Bottle" }, { "value": "gift", "label": "Gift" }, { "value": "sparkle", "label": "Sparkle" }, { "value": "truck", "label": "Delivery" }, { "value": "lock", "label": "Secure" } ], "default": "bottle" },
      { "type": "text", "id": "title", "label": "Title", "default": "Curated icons" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Designer fragrances selected for their character and craft." }
    ] }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Discover Veloura", "blocks": [
    { "type": "pillar", "settings": { "icon": "bottle", "title": "Curated icons", "text": "Designer fragrances selected for their character and craft." } },
    { "type": "pillar", "settings": { "icon": "sparkle", "title": "Discover more", "text": "Smaller formats make it easy to explore new signatures." } },
    { "type": "pillar", "settings": { "icon": "gift", "title": "Made to gift", "text": "Every order is presented in Veloura packaging." } }
  ] }]
}
{% endschema %}
