{%- comment -%}
  Original generic bottle illustration used when a product has no image.
  Params: shape ('square' | 'round' | 'faceted'), label (alt text)
{%- endcomment -%}
{%- assign shape = shape | default: 'square' -%}
{%- assign uid = 'pb' | append: section.id | append: forloop.index | append: shape | handle -%}
<div class="placeholder-bottle" role="img" aria-label="{{ label | default: shop.name | escape }}">
  <svg viewBox="0 0 120 180" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="{{ uid }}-g" x1="0" x2="1" y1="0" y2="1"><stop offset="0" stop-color="#ffffff" stop-opacity=".55"/><stop offset=".45" stop-color="#ffffff" stop-opacity=".08"/><stop offset="1" stop-color="#ffffff" stop-opacity=".25"/></linearGradient>
      <linearGradient id="{{ uid }}-l" x1="0" x2="0" y1="0" y2="1"><stop offset="0" style="stop-color:var(--c-accent-strong)"/><stop offset="1" style="stop-color:var(--c-accent)"/></linearGradient>
      <linearGradient id="{{ uid }}-m" x1="0" x2="1"><stop offset="0" stop-color="#8f7447"/><stop offset=".5" stop-color="#f3d7b7"/><stop offset="1" stop-color="#ad8153"/></linearGradient>
    </defs>
    {%- case shape -%}
      {%- when 'round' -%}
        <rect x="47" y="12" width="26" height="28" rx="3" fill="url(#{{ uid }}-m)"/>
        <rect x="50" y="40" width="20" height="9" fill="url(#{{ uid }}-m)" opacity=".85"/>
        <path d="M30 70c0-12 12-20 30-20s30 8 30 20v80c0 10-8 16-18 16H48c-10 0-18-6-18-16Z" fill="url(#{{ uid }}-l)" opacity=".85"/>
        <path d="M30 70c0-12 12-20 30-20s30 8 30 20v80c0 10-8 16-18 16H48c-10 0-18-6-18-16Z" fill="url(#{{ uid }}-g)" stroke="#fff" stroke-opacity=".35"/>
      {%- when 'faceted' -%}
        <path d="M44 6h32l8 14-8 18H44l-8-18Z" fill="url(#{{ uid }}-l)" opacity=".9"/>
        <path d="M44 6h32l8 14-8 18H44l-8-18Z" fill="url(#{{ uid }}-g)"/>
        <rect x="50" y="38" width="20" height="10" fill="url(#{{ uid }}-m)"/>
        <path d="M40 50h40l18 22v70l-18 26H40l-18-26V72Z" fill="url(#{{ uid }}-l)" opacity=".85"/>
        <path d="M40 50h40l18 22v70l-18 26H40l-18-26V72Zm0 0 6 22h28l6-22M46 72v70M74 72v70M46 142l-6 26M74 142l6 26" fill="url(#{{ uid }}-g)" stroke="#fff" stroke-opacity=".35"/>
      {%- else -%}
        <rect x="38" y="6" width="44" height="34" rx="4" fill="#111114"/>
        <rect x="38" y="6" width="44" height="34" rx="4" fill="url(#{{ uid }}-g)" opacity=".5"/>
        <rect x="48" y="40" width="24" height="10" fill="url(#{{ uid }}-m)"/>
        <rect x="24" y="52" width="72" height="118" rx="9" fill="url(#{{ uid }}-l)" opacity=".85"/>
        <rect x="24" y="52" width="72" height="118" rx="9" fill="url(#{{ uid }}-g)" stroke="#fff" stroke-opacity=".35"/>
        <rect x="30" y="58" width="6" height="104" rx="3" fill="#fff" opacity=".35"/>
    {%- endcase -%}
  </svg>
</div>
