{%- comment -%} Params: product, variant (optional), show_from (bool) {%- endcomment -%}
{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  assign compare = target.compare_at_price
  assign on_sale = false
  if compare > target.price
    assign on_sale = true
  endif
-%}
<span class="price{% if on_sale %} price--on-sale{% endif %}">
  {%- if on_sale -%}
    <span class="visually-hidden">{{ 'accessibility.regular_price' | t }}</span><s>{{ compare | money }}</s>
    <span class="visually-hidden">{{ 'accessibility.sale_price' | t }}</span><span class="price--sale">{{ target.price | money }}</span>
  {%- elsif show_from and product.price_varies -%}
    {%- assign min_price = product.price_min | money -%}
    {{ 'products.product.from_price' | t: price: min_price }}
  {%- else -%}
    {{ target.price | money }}
  {%- endif -%}
  {%- if target.unit_price_measurement -%}
    <small class="muted">({{ target.unit_price | money }} {{ 'accessibility.unit_price_separator' | t }} {% if target.unit_price_measurement.reference_value != 1 %}{{ target.unit_price_measurement.reference_value }}{% endif %}{{ target.unit_price_measurement.reference_unit }})</small>
  {%- endif -%}
</span>
