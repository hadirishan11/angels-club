{%- liquid
  assign threshold = settings.free_shipping_threshold | times: 100
-%}
{%- if threshold > 0 -%}
  {%- liquid
    assign remaining = threshold | minus: cart.total_price
    assign pct = cart.total_price | times: 100.0 | divided_by: threshold | at_most: 100 | round
  -%}
  <div class="ship-progress">
    <p class="ship-progress__text mb-0">
      {%- if remaining > 0 -%}
        {%- assign remaining_money = remaining | money -%}
        {{- 'cart.free_shipping_remaining_html' | t: amount: remaining_money -}}
      {%- else -%}
        {{- 'cart.free_shipping_unlocked' | t -}}
      {%- endif -%}
    </p>
    <div class="ship-progress__bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ pct }}" aria-label="{{ 'cart.free_shipping_progress' | t }}" style="margin-top: 0.6rem;">
      <span style="--pct: {{ pct }}%;"></span>
    </div>
  </div>
{%- endif -%}
