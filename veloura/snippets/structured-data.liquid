{%- comment -%}
  JSON-LD structured data for rich results.
  - Home: Organization + WebSite (with sitelinks search box)
  - Product: Product with offers, brand (vendor = fragrance house), rating
  - Article: Article
  Breadcrumbs are emitted by the breadcrumbs snippet; FAQPage by the FAQ section.
{%- endcomment -%}
{%- if request.page_type == 'index' -%}
  {%- liquid
    assign same_as = ''
    if settings.social_instagram != blank
      assign same_as = same_as | append: settings.social_instagram | append: '|'
    endif
    if settings.social_tiktok != blank
      assign same_as = same_as | append: settings.social_tiktok | append: '|'
    endif
    if settings.social_pinterest != blank
      assign same_as = same_as | append: settings.social_pinterest | append: '|'
    endif
    if settings.social_youtube != blank
      assign same_as = same_as | append: settings.social_youtube | append: '|'
    endif
    assign same_as = same_as | split: '|'
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": {{ request.origin | append: '/#organization' | json }},
          "name": {{ settings.seo_org_name | default: shop.name | json }},
          "url": {{ request.origin | append: routes.root_url | json }}
          {%- if settings.seo_logo -%},
          "logo": {{ settings.seo_logo | image_url: width: 600 | prepend: 'https:' | json }}
          {%- endif -%}
          {%- if same_as.size > 0 -%},
          "sameAs": {{ same_as | json }}
          {%- endif -%}
        },
        {
          "@type": "WebSite",
          "@id": {{ request.origin | append: '/#website' | json }},
          "name": {{ shop.name | json }},
          "url": {{ request.origin | append: routes.root_url | json }},
          "publisher": { "@id": {{ request.origin | append: '/#organization' | json }} },
          "potentialAction": {
            "@type": "SearchAction",
            "target": {
              "@type": "EntryPoint",
              "urlTemplate": {{ request.origin | append: routes.search_url | append: '?q={search_term_string}' | json }}
            },
            "query-input": "required name=search_term_string"
          }
        }
      ]
    }
  </script>
{%- endif -%}

{%- if request.page_type == 'product' -%}
  {%- liquid
    assign rating = product.metafields.reviews.rating.value
    assign rating_count = product.metafields.reviews.rating_count.value
    assign notes_top = product.metafields.veloura.notes_top.value | join: ', '
    assign notes_heart = product.metafields.veloura.notes_heart.value | join: ', '
    assign notes_base = product.metafields.veloura.notes_base.value | join: ', '
    assign price_valid_until = 'now' | date: '%s' | plus: 31536000 | date: '%Y-%m-%d'
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "@id": {{ request.origin | append: product.url | append: '#product' | json }},
      "name": {{ product.title | json }},
      "url": {{ request.origin | append: product.url | json }},
      "description": {{ product.description | strip_html | strip_newlines | truncate: 5000 | json }},
      {%- if product.featured_media -%}
      "image": [
        {%- for media in product.media limit: 5 -%}
          {{ media.preview_image | image_url: width: 1200 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
      {%- endif -%}
      {%- if product.vendor != blank -%}
      "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
      {%- endif -%}
      {%- if product.selected_or_first_available_variant.sku != blank -%}
      "sku": {{ product.selected_or_first_available_variant.sku | json }},
      {%- endif -%}
      {%- if notes_top != blank or notes_heart != blank or notes_base != blank -%}
      "additionalProperty": [
        {%- if notes_top != blank -%}{ "@type": "PropertyValue", "name": "Top notes", "value": {{ notes_top | json }} }{%- endif -%}
        {%- if notes_heart != blank -%}{%- if notes_top != blank -%},{%- endif -%}{ "@type": "PropertyValue", "name": "Heart notes", "value": {{ notes_heart | json }} }{%- endif -%}
        {%- if notes_base != blank -%}{%- if notes_top != blank or notes_heart != blank -%},{%- endif -%}{ "@type": "PropertyValue", "name": "Base notes", "value": {{ notes_base | json }} }{%- endif -%}
      ],
      {%- endif -%}
      {%- if rating != blank and rating_count > 0 -%}
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": {{ rating.rating | json }},
        "bestRating": {{ rating.scale_max | json }},
        "worstRating": {{ rating.scale_min | json }},
        "reviewCount": {{ rating_count | json }}
      },
      {%- endif -%}
      "offers": [
        {%- for variant in product.variants -%}
        {
          "@type": "Offer",
          {%- if variant.title != 'Default Title' -%}
          "name": {{ variant.title | json }},
          {%- endif -%}
          {%- if variant.sku != blank -%}
          "sku": {{ variant.sku | json }},
          {%- endif -%}
          {%- if variant.barcode.size == 12 -%}
          "gtin12": {{ variant.barcode | json }},
          {%- elsif variant.barcode.size == 13 -%}
          "gtin13": {{ variant.barcode | json }},
          {%- endif -%}
          "availability": "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "itemCondition": "https://schema.org/NewCondition",
          "price": {{ variant.price | divided_by: 100.00 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "priceValidUntil": {{ price_valid_until | json }},
          "url": {{ request.origin | append: variant.url | json }},
          "seller": { "@type": "Organization", "name": {{ shop.name | json }} }
        }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{%- if request.page_type == 'article' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": {{ article.title | truncate: 110 | json }},
      "description": {{ article.excerpt_or_content | strip_html | truncatewords: 40 | json }},
      {%- if article.image -%}
      "image": [{{ article.image | image_url: width: 1200 | prepend: 'https:' | json }}],
      {%- endif -%}
      "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
      "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
      "author": { "@type": "Person", "name": {{ article.author | json }} },
      "publisher": {
        "@type": "Organization",
        "name": {{ shop.name | json }}
        {%- if settings.seo_logo -%},
        "logo": { "@type": "ImageObject", "url": {{ settings.seo_logo | image_url: width: 600 | prepend: 'https:' | json }} }
        {%- endif -%}
      },
      "mainEntityOfPage": {{ request.origin | append: article.url | json }}
    }
  </script>
{%- endif -%}
