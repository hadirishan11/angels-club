{%- comment -%}
  Uses Shopify's standard reviews metafields (written by most review apps).
  Params: product, show_count (bool)
{%- endcomment -%}
{%- assign rating = product.metafields.reviews.rating.value -%}
{%- assign count = product.metafields.reviews.rating_count.value | default: 0 -%}
{%- if rating != blank and count > 0 -%}
  {%- assign pct = rating.rating | divided_by: rating.scale_max | times: 100 | round: 1 -%}
  <span class="stars">
    <span class="stars__icons" style="--pct: {{ pct }}%;" role="img" aria-label="{{ 'products.product.rating_label' | t: rating: rating.rating, max: rating.scale_max }}"></span>
    {%- if show_count -%}
      <span>{{ rating.rating | round: 1 }} · {{ 'products.product.review_count' | t: count: count }}</span>
    {%- endif -%}
  </span>
{%- endif -%}
