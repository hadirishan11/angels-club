            "perk_4": "Gift-ready packaging, always."
          }
        },
        "description": { "type": "description", "settings": { "heading": "The scent", "open": true } },
        "authenticity": {
          "type": "collapsible",
          "settings": {
            "heading": "Authenticity",
            "content": "<p>Every decant is drawn from a full, original bottle bought from an authorised source. We keep batch codes on file and will share them on request.</p>"
          }
        },
        "shipping": {
          "type": "collapsible",
          "settings": {
            "heading": "Shipping & returns",
            "content": "<p>Orders ship within one working day. Complimentary shipping over $40. Unopened decants can be returned within 14 days.</p>"
          }
        }
      },
      "block_order": ["title", "price", "notes", "picker", "buy", "perks", "description", "authenticity", "shipping"],
      "settings": { "media_ratio": "4 / 5", "sticky_atc": true }
