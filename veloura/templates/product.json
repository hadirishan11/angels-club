        "t3": { "type": "item", "settings": { "icon": "truck", "title": "Ships in 24 h", "text": "Free over $40" } },
        "t4": { "type": "item", "settings": { "icon": "return", "title": "Easy returns", "text": "14 days on unopened decants" } }
