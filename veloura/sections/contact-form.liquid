{%- assign s = section.settings -%}
<section class="section scheme-{{ s.color_scheme }}" style="{% render 'section-style', pt: section.settings.padding_top, pb: section.settings.padding_bottom %}">
  <div class="page-width">
    <div class="contact">
      <div>
        {%- if s.eyebrow != blank -%}<p class="eyebrow eyebrow--gold">{{ s.eyebrow }}</p>{%- endif -%}
        <h2 class="h1">{{ s.heading }}</h2>
        {%- if s.text != blank -%}<div class="text-muted rte">{{ s.text }}</div>{%- endif -%}
        <dl class="contact__details mt-4">
          {%- for block in section.blocks -%}
            <div {{ block.shopify_attributes }}>
              <dt>{{ block.settings.label }}</dt>
              <dd>{% if block.settings.link != blank %}<a class="link-underline" href="{{ block.settings.link }}">{{ block.settings.value }}</a>{% else %}{{ block.settings.value }}{% endif %}</dd>
            </div>
          {%- endfor -%}
        </dl>
      </div>
      <div>
        {%- form 'contact', id: 'ContactForm' -%}
          {%- if form.posted_successfully? -%}
            <p class="h3" role="status" data-form-status>{{ s.success }}</p>
          {%- else -%}
            {%- if form.errors -%}
              <div class="form-message form-message--error" role="alert" data-form-status>{{ form.errors | default_errors }}</div>
            {%- endif -%}
            <div class="contact__form-grid">
              <div class="field">
                <label class="field__label" for="ContactName">{{ 'contact.name' | t }}</label>
                <input class="field__input" id="ContactName" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}">
              </div>
              <div class="field">
                <label class="field__label" for="ContactEmail">{{ 'contact.email' | t }} <span aria-hidden="true">*</span></label>
                <input class="field__input" id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}"{% if form.errors contains 'email' %} aria-invalid="true"{% endif %}>
              </div>
              <div class="field field--full">
                <label class="field__label" for="ContactOrder">{{ 'contact.order' | t }}</label>
                <input class="field__input" id="ContactOrder" type="text" name="contact[order_number]" value="">
              </div>
              <div class="field field--full">
                <label class="field__label" for="ContactBody">{{ 'contact.message' | t }} <span aria-hidden="true">*</span></label>
                <textarea class="field__input" id="ContactBody" name="contact[body]" rows="6" required>{{ form.body }}</textarea>
              </div>
            </div>
            <button type="submit" class="btn">{{ 'contact.send' | t }}</button>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "class": "section-contact",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "The atelier" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Write to us" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>A question about a scent, an order or a gift. We reply within one working day.</p>" },
    { "type": "text", "id": "success", "label": "Success message", "default": "Thank you. We will reply within one working day." },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "ivory", "label": "Ivory" },
        { "value": "ink", "label": "Ink" },
        { "value": "stone", "label": "Stone" }
      ],
      "default": "ivory"
    },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 120 }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Contact detail",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Email" },
        { "type": "text", "id": "value", "label": "Value", "default": "hello@example.com" },
        { "type": "url", "id": "link", "label": "Link", "info": "e.g. mailto:hello@yourdomain.com" }
      ]
    }
  ],
  "presets": [ { "name": "Contact form", "blocks": [ { "type": "detail" } ] } ]
}
{% endschema %}
