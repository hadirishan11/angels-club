{%- assign s = section.settings -%}
<section class="section scheme-{{ s.color_scheme }}{% if s.border %} rule{% endif %}" style="{% render 'section-style', pt: section.settings.padding_top, pb: section.settings.padding_bottom %}{% if s.border %} border-bottom: var(--hairline);{% endif %}">
  <div class="page-width">
    {%- if s.heading != blank -%}<h2 class="visually-hidden">{{ s.heading }}</h2>{%- endif -%}
    <ul class="trust" role="list" style="--cols: {{ section.blocks.size | at_least: 1 | at_most: 4 }};">
      {%- for block in section.blocks -%}
        <li class="trust__item reveal" style="--delay: {{ forloop.index0 | times: 90 }}ms;" {{ block.shopify_attributes }}>
          {% render 'icon', name: block.settings.icon %}
          <span class="trust__title">{{ block.settings.title }}</span>
          {%- if block.settings.text != blank -%}<span class="trust__text">{{ block.settings.text }}</span>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Reassurance bar",
  "class": "section-trust",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading (screen readers)", "default": "Why Veloura" },
    { "type": "checkbox", "id": "border", "label": "Hairline borders", "default": true },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "ivory", "label": "Ivory" },
        { "value": "ink", "label": "Ink" },
        { "value": "stone", "label": "Stone" }
      ],
      "default": "ivory"
    },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "seal", "label": "Seal (authentic)" },
            { "value": "atomizer", "label": "Atomizer" },
            { "value": "drop", "label": "Drop" },
            { "value": "truck", "label": "Shipping" },
            { "value": "return", "label": "Returns" },
            { "value": "gift", "label": "Gift" },
            { "value": "lock", "label": "Secure" },
            { "value": "leaf", "label": "Leaf" }
          ],
          "default": "seal"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "100% authentic" },
        { "type": "text", "id": "text", "label": "Text", "default": "Decanted from original bottles" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reassurance bar",
      "blocks": [
        { "type": "item" },
        { "type": "item", "settings": { "icon": "atomizer", "title": "Glass atomisers", "text": "10 ml, fine mist, travel-ready" } },
        { "type": "item", "settings": { "icon": "truck", "title": "Ships in 24 h", "text": "Free over €75" } },
        { "type": "item", "settings": { "icon": "lock", "title": "Secure checkout", "text": "All major cards & wallets" } }
      ]
    }
  ]
}
{% endschema %}
