{%- liquid
  assign s = section.settings
  assign m = product.metafields.veloura
  assign notes_top = m.notes_top.value
  assign notes_heart = m.notes_heart.value
  assign notes_base = m.notes_base.value
  assign longevity = m.longevity.value
  assign sillage = m.sillage.value
  assign seasons = m.season.value
  assign occasions = m.occasion.value
  assign families = m.scent_family.value
  assign concentration = m.concentration.value
  assign perfumer = m.perfumer.value
  assign year = m.year.value

  assign sample = false
  if request.design_mode and notes_top == blank and notes_heart == blank and notes_base == blank
    assign sample = true
    assign notes_top = 'Bergamot,Pink pepper,Saffron' | split: ','
    assign notes_heart = 'Iris,Leather,Violet' | split: ','
    assign notes_base = 'Amber,Oud,Smoked vanilla' | split: ','
    assign longevity = 4
    assign sillage = 3
    assign seasons = 'Autumn,Winter' | split: ','
    assign occasions = 'Evening,Close encounters' | split: ','
    assign families = 'Amber,Woody' | split: ','
    assign concentration = 'Eau de Parfum'
  endif

  assign has_profile = false
  if notes_top != blank or notes_heart != blank or notes_base != blank or longevity != blank or sillage != blank
    assign has_profile = true
  endif
-%}
{%- if has_profile -%}
<section id="FragranceProfile" class="section scheme-{{ s.color_scheme }}" style="{% render 'section-style', pt: section.settings.padding_top, pb: section.settings.padding_bottom %}" aria-labelledby="ProfileHeading-{{ section.id }}">
  <div class="page-width">
    <div class="section-header reveal">
      {%- if s.eyebrow != blank -%}<p class="eyebrow eyebrow--gold">{{ s.eyebrow }}</p>{%- endif -%}
      <h2 id="ProfileHeading-{{ section.id }}">{{ s.heading }}</h2>
      {%- if sample -%}<p class="text-sm">{{ 'products.profile.sample_note' | t }}</p>{%- endif -%}
    </div>

    <div class="profile">
      <div class="pyramid reveal">
        {%- if notes_top != blank -%}
          <div class="pyramid__tier">
            <h3 class="pyramid__label mb-0">{{ 'products.profile.top' | t }}<small>{{ 'products.profile.top_hint' | t }}</small></h3>
            <p class="pyramid__notes mb-0">{{ notes_top | join: ', ' }}</p>
          </div>
        {%- endif -%}
        {%- if notes_heart != blank -%}
          <div class="pyramid__tier">
            <h3 class="pyramid__label mb-0">{{ 'products.profile.heart' | t }}<small>{{ 'products.profile.heart_hint' | t }}</small></h3>
            <p class="pyramid__notes mb-0">{{ notes_heart | join: ', ' }}</p>
          </div>
        {%- endif -%}
        {%- if notes_base != blank -%}
          <div class="pyramid__tier">
            <h3 class="pyramid__label mb-0">{{ 'products.profile.base' | t }}<small>{{ 'products.profile.base_hint' | t }}</small></h3>
            <p class="pyramid__notes mb-0">{{ notes_base | join: ', ' }}</p>
          </div>
        {%- endif -%}
      </div>

      <div class="reveal" style="--delay: 150ms;">
        <div class="meters">
          {%- if longevity != blank -%}
            {% render 'meter', label: s.longevity_label, value: longevity, words: s.longevity_words %}
          {%- endif -%}
          {%- if sillage != blank -%}
            {% render 'meter', label: s.sillage_label, value: sillage, words: s.sillage_words %}
          {%- endif -%}
        </div>
        <dl class="facts" style="margin-top: var(--space-5);">
          {%- if seasons != blank -%}
            <div><dt class="fact__label">{{ 'products.profile.season' | t }}</dt><dd class="fact__value" style="margin: 0;">{{ seasons | join: ', ' }}</dd></div>
          {%- endif -%}
          {%- if occasions != blank -%}
            <div><dt class="fact__label">{{ 'products.profile.occasion' | t }}</dt><dd class="fact__value" style="margin: 0;">{{ occasions | join: ', ' }}</dd></div>
          {%- endif -%}
          {%- if families != blank -%}
            <div><dt class="fact__label">{{ 'products.profile.family' | t }}</dt><dd class="fact__value" style="margin: 0;">{{ families | join: ', ' }}</dd></div>
          {%- endif -%}
          {%- if concentration != blank -%}
            <div><dt class="fact__label">{{ 'products.profile.concentration' | t }}</dt><dd class="fact__value" style="margin: 0;">{{ concentration }}</dd></div>
          {%- endif -%}
          {%- if perfumer != blank -%}
            <div><dt class="fact__label">{{ 'products.profile.perfumer' | t }}</dt><dd class="fact__value" style="margin: 0;">{{ perfumer }}</dd></div>
          {%- endif -%}
          {%- if year != blank -%}
            <div><dt class="fact__label">{{ 'products.profile.year' | t }}</dt><dd class="fact__value" style="margin: 0;">{{ year }}</dd></div>
          {%- endif -%}
        </dl>
      </div>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Fragrance profile",
  "class": "section-fragrance-profile",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "paragraph", "content": "Content comes from the product's 'veloura' metafields (notes, longevity, sillage, season, occasion). The section hides itself when a product has no profile." },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "The composition" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Scent profile" },
    { "type": "text", "id": "longevity_label", "label": "Longevity label", "default": "Longevity" },
    { "type": "text", "id": "longevity_words", "label": "Longevity scale (5 words, comma separated)", "default": "Fleeting, Soft, Moderate, Long-lasting, Enduring" },
    { "type": "text", "id": "sillage_label", "label": "Sillage label", "default": "Sillage" },
    { "type": "text", "id": "sillage_words", "label": "Sillage scale (5 words, comma separated)", "default": "Skin scent, Intimate, Moderate, Noticeable, Room-filling" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "ivory", "label": "Ivory" },
        { "value": "ink", "label": "Ink" },
        { "value": "stone", "label": "Stone" }
      ],
      "default": "ink"
    },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "presets": [ { "name": "Fragrance profile" } ]
}
{% endschema %}
