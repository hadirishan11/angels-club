<div class="page-width">{% render 'breadcrumbs' %}</div>
<section class="section" style="--pt: var(--space-4); --pt-d: var(--space-5);">
  <div class="page-width">
    <header class="section-header section-header--center">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--gold">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1>{{ blog.title }}</h1>
      {%- if section.settings.intro != blank -%}<div class="text-muted">{{ section.settings.intro }}</div>{%- endif -%}
    </header>
    {%- paginate blog.articles by 12 -%}
      <ul class="grid" role="list" style="--cols-m: 1; --cols-t: 2; --cols-d: 3; --grid-gap: var(--space-5);">
        {%- for article in blog.articles -%}
          <li>{% render 'article-card', article: article, heading_tag: 'h2', index: forloop.index0 %}</li>
        {%- endfor -%}
      </ul>
      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="{{ 'general.pagination.label' | t }}">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" rel="prev" aria-label="{{ 'general.pagination.previous' | t }}">←</a>{%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- else -%}<span{% if part.title == paginate.current_page %} aria-current="page"{% endif %}>{{ part.title }}</span>{%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}" rel="next" aria-label="{{ 'general.pagination.next' | t }}">→</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Journal",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "The journal" },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>Notes on scent, houses and the art of wearing perfume.</p>" }
  ]
}
{% endschema %}
