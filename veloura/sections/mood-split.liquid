{%- if section.settings.heading != blank -%}
  <div class="section page-width" style="--pb: var(--space-4); --pb-d: var(--space-5);">
    <div class="section-header section-header--center reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>
  </div>
{%- endif -%}
 {%- liquid
  assign mood_tag = 'h3'
  if section.settings.heading == blank
    assign mood_tag = 'h2'
  endif
-%}
<div class="mood-split" style="--mood-h: {{ section.settings.height }}svh;">
  {%- for block in section.blocks -%}
    {%- liquid
      assign b = block.settings
      assign link = b.link | default: b.collection.url | default: routes.collections_url
      assign img = b.image | default: b.collection.featured_image
    -%}
    <a href="{{ link }}" class="mood{% if b.light_text == false %} mood--light{% endif %}" {{ block.shopify_attributes }}>
      <div class="media">
        {%- if img -%}
          {% render 'image', image: img, sizes: '(min-width: 750px) 50vw, 100vw', alt: b.title %}
        {%- else -%}
          {%- if forloop.first -%}{{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}{%- else -%}{{ 'collection-2' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
        {%- endif -%}
      </div>
      <div class="mood__content reveal" style="--delay: {{ forloop.index0 | times: 150 }}ms;">
        {%- if b.eyebrow != blank -%}<p class="eyebrow" style="color: inherit; opacity: 0.8;">{{ b.eyebrow }}</p>{%- endif -%}
        <{{ mood_tag }} class="mood__title">{{ b.title }}</{{ mood_tag }}>
        {%- if b.text != blank -%}<p class="mood__text">{{ b.text }}</p>{%- endif -%}
        <span class="link">{{ b.button_label }} {% render 'icon', name: 'arrow-right' %}</span>
      </div>
    </a>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Mood split",
  "class": "section-mood-split",
  "max_blocks": 2,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Two moods" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose by feeling, not by gender." },
    { "type": "range", "id": "height", "label": "Panel height (desktop)", "min": 50, "max": 100, "step": 5, "unit": "vh", "default": 85 }
  ],
  "blocks": [
    {
      "type": "mood",
      "name": "Mood",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Falls back to the collection image." },
        { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Woody · Amber · Smoke" },
        { "type": "text", "id": "title", "label": "Title", "default": "Noir" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Resin, leather and dusk. Scents that linger close and stay late." },
        { "type": "text", "id": "button_label", "label": "Link label", "default": "Discover Noir" },
        { "type": "url", "id": "link", "label": "Custom link", "info": "Overrides the collection link." },
        { "type": "checkbox", "id": "light_text", "label": "Light text (for dark images)", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mood split",
      "blocks": [
        { "type": "mood" },
        {
          "type": "mood",
          "settings": {
            "eyebrow": "Floral · Fresh · Musk",
            "title": "Rosé",
            "text": "Petals, light and skin. Bright scents that open like a window.",
            "button_label": "Discover Rosé",
            "light_text": false
          }
        }
      ]
    }
  ]
}
{% endschema %}
