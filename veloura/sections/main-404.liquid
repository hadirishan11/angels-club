<section class="not-found page-width">
  <p class="eyebrow eyebrow--gold">404</p>
  <h1>{{ section.settings.heading }}</h1>
  <p class="text-muted">{{ section.settings.text }}</p>
  <div class="hero__actions" style="justify-content: center; margin-top: var(--space-4);">
    <a class="btn" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
    <button type="button" class="btn btn--outline" data-drawer-open="SearchDrawer" aria-controls="SearchDrawer">{{ 'general.search.title' | t }}</button>
  </div>
</section>

{% schema %}
{
  "name": "404",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "This scent has faded." },
    { "type": "text", "id": "text", "label": "Text", "default": "The page you were looking for is no longer here." }
  ]
}
{% endschema %}
