{%- assign s = section.settings -%}
<section class="section scheme-{{ s.color_scheme }}" style="{% render 'section-style', pt: section.settings.padding_top, pb: section.settings.padding_bottom %}">
  <div class="page-width">
    <div class="section-header{% if s.center %} section-header--center{% endif %} reveal">
      {%- if s.eyebrow != blank -%}<p class="eyebrow eyebrow--gold">{{ s.eyebrow }}</p>{%- endif -%}
      <h2>{{ s.heading }}</h2>
      {%- if s.text != blank -%}<div>{{ s.text }}</div>{%- endif -%}
    </div>
    <ol class="steps" role="list" style="--cols: {{ section.blocks.size | at_least: 1 | at_most: 4 }};">
      {%- for block in section.blocks -%}
        <li class="step reveal" style="--delay: {{ forloop.index0 | times: 120 }}ms;" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="media">{% render 'image', image: block.settings.image, sizes: '(min-width: 750px) 25vw, 100vw' %}</div>
          {%- endif -%}
          <span class="step__num" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <h3 class="step__title">{{ block.settings.title }}</h3>
          <div class="step__text">{{ block.settings.text }}</div>
        </li>
      {%- endfor -%}
    </ol>
    {%- if s.button_label != blank -%}
      <div class="mt-4{% if s.center %} flex-center{% endif %} reveal" style="margin-top: var(--space-5);">
        <a href="{{ s.button_link | default: routes.root_url }}" class="btn btn--outline">{{ s.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "How we decant",
  "class": "section-steps",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "The atelier" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How we decant" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Every drop comes from a bottle we bought ourselves. Nothing diluted, nothing reformulated.</p>" },
    { "type": "checkbox", "id": "center", "label": "Center heading", "default": false },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Our authenticity promise" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "ivory", "label": "Ivory" },
        { "value": "ink", "label": "Ink" },
        { "value": "stone", "label": "Stone" }
      ],
      "default": "ink"
    },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 120 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 120 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (optional)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Sourced" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Full bottles from authorised retailers and the houses themselves. Batch codes kept on file.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "How we decant",
      "blocks": [
        { "type": "step" },
        { "type": "step", "settings": { "title": "Decanted", "text": "<p>Drawn from the original bottle with a sterile pipette. Never diluted, never mixed.</p>" } },
        { "type": "step", "settings": { "title": "Sealed in glass", "text": "<p>10 ml glass atomisers with a fine mist. Labelled by hand with house, name and batch.</p>" } },
        { "type": "step", "settings": { "title": "Sent with care", "text": "<p>Wrapped, padded and shipped within one working day. Discreet packaging.</p>" } }
      ]
    }
  ]
}
{% endschema %}
