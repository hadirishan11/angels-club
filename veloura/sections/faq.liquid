{%- assign s = section.settings -%}
<section class="section scheme-{{ s.color_scheme }}" style="{% render 'section-style', pt: section.settings.padding_top, pb: section.settings.padding_bottom %}">
  <div class="page-width page-width--narrow">
    {%- if s.heading != blank -%}
      <div class="section-header reveal">
        {%- if s.eyebrow != blank -%}<p class="eyebrow eyebrow--gold">{{ s.eyebrow }}</p>{%- endif -%}
        <{{ s.heading_tag }} class="h2">{{ s.heading }}</{{ s.heading_tag }}>
        {%- if s.text != blank -%}<div class="text-muted">{{ s.text }}</div>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="accordion accordion--large">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'group' -%}
            <h2 class="eyebrow" style="display: block; margin: var(--space-5) 0 var(--space-1);" {{ block.shopify_attributes }}>{{ block.settings.title }}</h2>
          {%- when 'question' -%}
            <details {{ block.shopify_attributes }}{% if block.settings.open %} open{% endif %}>
              <summary>{{ block.settings.question }} {% render 'icon', name: 'plus' %}</summary>
              <div class="accordion__content rte">{{ block.settings.answer }}</div>
            </details>
        {%- endcase -%}
      {%- endfor -%}
    </div>
    {%- if s.contact_text != blank -%}
      <p class="mt-4 text-muted">{{ s.contact_text }} <a class="link-underline" href="{{ s.contact_link | default: '/pages/contact' }}">{{ s.contact_link_label }}</a></p>
    {%- endif -%}
  </div>
</section>

{%- if s.schema -%}
  {%- liquid
    assign q_count = 0
    for block in section.blocks
      if block.type == 'question'
        assign q_count = q_count | plus: 1
      endif
    endfor
  -%}
  {%- if q_count > 0 -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {%- assign first_q = true -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'question' -%}
              {%- unless first_q -%},{%- endunless -%}
              {
                "@type": "Question",
                "name": {{ block.settings.question | json }},
                "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | json }} }
              }
              {%- assign first_q = false -%}
            {%- endif -%}
          {%- endfor -%}
        ]
      }
    </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "class": "section-faq",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked" },
    { "type": "select", "id": "heading_tag", "label": "Heading tag (SEO)", "options": [ { "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" } ], "default": "h2" },
    { "type": "richtext", "id": "text", "label": "Intro" },
    { "type": "text", "id": "contact_text", "label": "Footer text", "default": "Still wondering?" },
    { "type": "text", "id": "contact_link_label", "label": "Footer link label", "default": "Write to us" },
    { "type": "url", "id": "contact_link", "label": "Footer link" },
    { "type": "checkbox", "id": "schema", "label": "Add FAQ structured data (SEO)", "default": true, "info": "Use on one page only, e.g. the FAQ page." },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "ivory", "label": "Ivory" },
        { "value": "ink", "label": "Ink" },
        { "value": "stone", "label": "Stone" }
      ],
      "default": "ivory"
    },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    { "type": "group", "name": "Group title", "settings": [ { "type": "text", "id": "title", "label": "Title", "default": "Ordering" } ] },
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Are your fragrances authentic?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Always. Every decant is drawn from a full, original bottle bought from an authorised source.</p>" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    }
  ],
  "presets": [ { "name": "FAQ", "blocks": [ { "type": "question" } ] } ]
}
{% endschema %}
