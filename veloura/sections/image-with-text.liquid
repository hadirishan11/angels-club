{%- assign s = section.settings -%}
<section class="section scheme-{{ s.color_scheme }}" style="{% render 'section-style', pt: section.settings.padding_top, pb: section.settings.padding_bottom %}">
  <div class="page-width">
    <div class="split{% if s.image_right %} split--reverse{% endif %}">
      <div class="split__media reveal">
        <div class="media" style="--ratio: {{ s.ratio }};">
          {% render 'image', image: s.image, sizes: '(min-width: 990px) 50vw, 100vw', placeholder: 'lifestyle-1' %}
        </div>
      </div>
      <div class="split__content reveal" style="--delay: 150ms;">
        {%- if s.eyebrow != blank -%}<p class="eyebrow eyebrow--gold">{{ s.eyebrow }}</p>{%- endif -%}
        <{{ s.heading_tag }} class="h2">{{ s.heading }}</{{ s.heading_tag }}>
        <div class="rte text-muted">{{ s.text }}</div>
        {%- if s.button_label != blank -%}
          <div class="mt-4"><a class="btn btn--outline" href="{{ s.button_link | default: routes.root_url }}">{{ s.button_label }}</a></div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "class": "section-image-text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image shape",
      "options": [
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "3 / 2", "label": "Landscape" }
      ],
      "default": "4 / 5"
    },
    { "type": "checkbox", "id": "image_right", "label": "Image on the right", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Our promise" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Only the original. Never a copy." },
    { "type": "select", "id": "heading_tag", "label": "Heading tag (SEO)", "options": [ { "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" } ], "default": "h2" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Every decant is drawn from a full bottle purchased from an authorised source. We keep batch codes and receipts on file, and we will share them on request.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "ivory", "label": "Ivory" },
        { "value": "ink", "label": "Ink" },
        { "value": "stone", "label": "Stone" }
      ],
      "default": "ivory"
    },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "presets": [ { "name": "Image with text" } ]
}
{% endschema %}
