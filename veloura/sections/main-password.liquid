<section class="hero hero--center" style="--hero-h: 100svh; --hero-h-m: 100svh;">
  <div class="hero__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: widths: '750, 1080, 1440, 1920, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: '' }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>
  <div class="hero__content page-width">
    <p class="eyebrow eyebrow--gold">{{ shop.name }}</p>
    <h1 class="hero__heading h-display">{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}<p class="hero__text center-block">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer', class: 'private-list__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter,private-list,prelaunch">
      {%- if form.posted_successfully? -%}
        <p class="h4" role="status">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <div class="form-inline" style="border-color: var(--c-ivory);">
          <label class="visually-hidden" for="PasswordEmail">{{ 'newsletter.label' | t }}</label>
          <input id="PasswordEmail" class="field__input" type="email" name="contact[email]" required placeholder="{{ 'newsletter.label' | t }}" style="color: var(--c-ivory);">
          <button type="submit" class="btn" style="color: var(--c-ivory);">{{ 'newsletter.button' | t }}</button>
        </div>
        {%- if form.errors -%}<p class="form-message form-message--error">{{ form.errors | default_errors }}</p>{%- endif -%}
      {%- endif -%}
    {%- endform -%}
    <details style="margin-top: var(--space-5);">
      <summary class="link" style="cursor: pointer; list-style: none;">{{ 'password.enter' | t }}</summary>
      {%- form 'storefront_password', class: 'private-list__form' -%}
        <div class="form-inline" style="border-color: var(--c-ivory);">
          <label class="visually-hidden" for="StorePassword">{{ 'password.label' | t }}</label>
          <input id="StorePassword" class="field__input" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.label' | t }}" style="color: var(--c-ivory);">
          <button type="submit" class="btn" style="color: var(--c-ivory);">{{ 'password.submit' | t }}</button>
        </div>
        {%- if form.errors -%}<p class="form-message form-message--error">{{ form.errors | default_errors }}</p>{%- endif -%}
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon." }
  ]
}
{% endschema %}
