{%- assign s = section.settings -%}
<section class="section scheme-{{ s.color_scheme }}" style="{% render 'section-style', pt: section.settings.padding_top, pb: section.settings.padding_bottom %}">
  <div class="page-width">
    {%- if s.heading != blank -%}
      <div class="section-header section-header--center reveal">
        {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        <h2>{{ s.heading }}</h2>
      </div>
    {%- endif -%}
    <ul class="tiles" role="list" style="--tiles: {{ section.blocks.size | at_least: 1 | at_most: 4 }};">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign link = b.link | default: b.collection.url | default: routes.collections_url
          assign img = b.image | default: b.collection.featured_image
          assign title = b.title | default: b.collection.title
        -%}
        <li class="reveal" style="--delay: {{ forloop.index0 | times: 100 }}ms;" {{ block.shopify_attributes }}>
          <a class="tile" href="{{ link }}">
            <div class="media media--zoom" style="--ratio: {{ s.ratio }};">
              {% render 'image', image: img, sizes: '(min-width: 990px) 25vw, 50vw', alt: title, placeholder: 'collection-1' %}
            </div>
            <div class="tile__content">
              <h3 class="tile__title">{{ title }}</h3>
              {%- if b.text != blank -%}<p class="tile__text">{{ b.text }}</p>{%- endif -%}
              <span class="link">{{ b.button_label }} {% render 'icon', name: 'arrow-right' %}</span>
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Category tiles",
  "class": "section-category-tiles",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Shop by" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your signature" },
    {
      "type": "select",
      "id": "ratio",
      "label": "Tile shape",
      "options": [
        { "value": "3 / 4", "label": "Portrait" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Soft portrait" }
      ],
      "default": "3 / 4"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "ivory", "label": "Ivory" },
        { "value": "ink", "label": "Ink" },
        { "value": "stone", "label": "Stone" }
      ],
      "default": "ivory"
    },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Falls back to the collection image. 1200 × 1600 px recommended." },
        { "type": "text", "id": "title", "label": "Title", "info": "Falls back to the collection name." },
        { "type": "text", "id": "text", "label": "Short line" },
        { "type": "text", "id": "button_label", "label": "Link label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Custom link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category tiles",
      "blocks": [
        { "type": "tile", "settings": { "title": "For her", "text": "Florals, musks and vanillas" } },
        { "type": "tile", "settings": { "title": "For him", "text": "Woods, spice and fresh classics" } },
        { "type": "tile", "settings": { "title": "Unisex", "text": "Niche scents for anyone" } },
        { "type": "tile", "settings": { "title": "Gift sets", "text": "Boxed, wrapped, ready to give" } }
      ]
    }
  ]
}
{% endschema %}
