{%- assign s = section.settings -%}
<section class="section scheme-{{ s.color_scheme }}" style="{% render 'section-style', pt: section.settings.padding_top, pb: section.settings.padding_bottom %}">
  <div class="page-width">
    <div class="section-header section-header--center reveal">
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      <h2>{{ s.heading }}</h2>
      {%- if s.rating != blank -%}
        <div class="reviews-summary" style="justify-content: center;">
          <span class="stars"><span class="stars__icons" style="--pct: {{ s.rating | times: 20 }}%;" aria-hidden="true"></span></span>
          <span class="text-sm">{{ s.rating }} / 5 · {{ s.rating_text }}</span>
        </div>
      {%- endif -%}
    </div>
    <ul class="reviews" role="list" style="--cols: {{ section.blocks.size | at_most: 3 | at_least: 1 }};">
      {%- for block in section.blocks -%}
        <li class="review reveal" style="--delay: {{ forloop.index0 | times: 120 }}ms;" {{ block.shopify_attributes }}>
          <figure class="mb-0" style="margin: 0; display: flex; flex-direction: column; gap: var(--space-2);">
            {%- if block.settings.stars > 0 -%}
              <span class="stars"><span class="stars__icons" style="--pct: {{ block.settings.stars | times: 20 }}%;" role="img" aria-label="{{ 'products.product.rating_label' | t: rating: block.settings.stars, max: 5 }}"></span></span>
            {%- endif -%}
            <blockquote class="review__quote">{{ block.settings.quote }}</blockquote>
            <figcaption>
              <span class="review__author">{{ block.settings.author }}</span>
              {%- if block.settings.product != blank -%}
                <br><a class="review__product link-underline" href="{{ block.settings.product.url }}">{{ block.settings.product.title }}</a>
              {%- elsif block.settings.product_name != blank -%}
                <br><span class="review__product">{{ block.settings.product_name }}</span>
              {%- endif -%}
            </figcaption>
          </figure>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Reviews",
  "class": "section-reviews",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "In their words" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Worn, then kept." },
    { "type": "text", "id": "rating", "label": "Average rating (e.g. 4.9)", "info": "Leave blank to hide. Only show a real, verifiable average." },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "from verified orders" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "ivory", "label": "Ivory" },
        { "value": "ink", "label": "Ink" },
        { "value": "stone", "label": "Stone" }
      ],
      "default": "ivory"
    },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Replace this with a real customer review." },
        { "type": "text", "id": "author", "label": "Name", "default": "Customer name" },
        { "type": "product", "id": "product", "label": "Product (optional)" },
        { "type": "text", "id": "product_name", "label": "Or product name" },
        { "type": "range", "id": "stars", "label": "Stars", "min": 0, "max": 5, "step": 1, "default": 5 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews",
      "blocks": [ { "type": "review" }, { "type": "review" }, { "type": "review" } ]
    }
  ]
}
{% endschema %}
