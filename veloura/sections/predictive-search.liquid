{%- comment -%} Rendered via the Section Rendering API from global.js. Not added to templates. {%- endcomment -%}
<div data-predictive-content>
  {%- if predictive_search.performed -%}
    {%- liquid
      assign products = predictive_search.resources.products
      assign collections = predictive_search.resources.collections
      assign articles = predictive_search.resources.articles
      assign queries = predictive_search.resources.queries
    -%}
    {%- if products.size == 0 and collections.size == 0 and articles.size == 0 and queries.size == 0 -%}
      <p class="text-muted">{{ 'general.search.no_results' | t: terms: predictive_search.terms }}</p>
    {%- else -%}
      {%- if queries.size > 0 -%}
        <div class="predictive__group predictive__queries">
          <p class="eyebrow">{{ 'general.search.suggestions' | t }}</p>
          {%- for query in queries -%}
            <a href="{{ query.url }}">{{ query.styled_text }}</a>
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- if products.size > 0 -%}
        <div class="predictive__group">
          <p class="eyebrow">{{ 'general.search.products' | t }}</p>
          <ul role="list">
            {%- for product in products -%}
              <li>
                <a class="predictive__item" href="{{ product.url }}">
                  <div class="media">
                    {%- if product.featured_media -%}
                      {{ product.featured_media.preview_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '', widths: '60, 120' }}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                  </div>
                  <div>
                    {%- if product.vendor != blank -%}<span class="card__house">{{ product.vendor }}</span>{%- endif -%}
                    <div class="card__title" style="font-size: 1.15rem;">{{ product.title }}</div>
                    <div class="text-sm text-muted">{{ product.price | money }}</div>
                  </div>
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
      {%- if collections.size > 0 -%}
        <div class="predictive__group predictive__queries">
          <p class="eyebrow">{{ 'general.search.collections' | t }}</p>
          {%- for c in collections -%}<a href="{{ c.url }}">{{ c.title }}</a>{%- endfor -%}
        </div>
      {%- endif -%}
      {%- if articles.size > 0 -%}
        <div class="predictive__group predictive__queries">
          <p class="eyebrow">{{ 'general.search.articles' | t }}</p>
          {%- for a in articles -%}<a href="{{ a.url }}">{{ a.title }}</a>{%- endfor -%}
        </div>
      {%- endif -%}
      <p class="mt-4"><a class="link" href="{{ routes.search_url }}?q={{ predictive_search.terms | url_encode }}&options[prefix]=last">{{ 'general.search.view_all' | t: terms: predictive_search.terms }} {% render 'icon', name: 'arrow-right' %}</a></p>
    {%- endif -%}
  {%- endif -%}
</div>
