{%- assign s = section.settings -%}
<section class="section scheme-{{ s.color_scheme }}" style="{% render 'section-style', pt: section.settings.padding_top, pb: section.settings.padding_bottom %}">
  <div class="page-width">
    <div class="section-header section-header--center reveal">
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      <h2>{{ s.heading }}</h2>
      {%- if s.text != blank -%}<div>{{ s.text }}</div>{%- endif -%}
    </div>
    <ul class="scroller scroller--desktop-grid" role="list" style="--cols-d: {{ s.columns_desktop }};">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        {%- assign title = block.settings.title | default: c.title | default: 'Scent family' -%}
        <li class="reveal" style="--delay: {{ forloop.index0 | modulo: 6 | times: 80 }}ms;" {{ block.shopify_attributes }}>
          <a href="{{ c.url | default: routes.collections_url }}" class="card">
            <div class="media media--zoom" style="--ratio: {{ s.ratio }};">
              {%- assign img = block.settings.image | default: c.featured_image -%}
              {% render 'image', image: img, sizes: '(min-width: 750px) 20vw, 70vw', alt: title, placeholder: 'collection-3' %}
            </div>
            <div class="card__body">
              <h3 class="card__title">{{ title }}</h3>
              {%- if block.settings.text != blank -%}<p class="card__notes">{{ block.settings.text }}</p>{%- endif -%}
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Scent families",
  "class": "section-collection-list",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Browse by family" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your accord" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "range", "id": "columns_desktop", "label": "Columns (desktop)", "min": 3, "max": 6, "step": 1, "default": 6 },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image shape",
      "options": [
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "2 / 3", "label": "Tall" }
      ],
      "default": "2 / 3"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "ivory", "label": "Ivory" },
        { "value": "ink", "label": "Ink" },
        { "value": "stone", "label": "Stone" }
      ],
      "default": "ivory"
    },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image (optional)" },
        { "type": "text", "id": "title", "label": "Title (optional)" },
        { "type": "text", "id": "text", "label": "Short description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scent families",
      "blocks": [
        { "type": "collection", "settings": { "title": "Woody", "text": "Cedar, sandalwood, vetiver" } },
        { "type": "collection", "settings": { "title": "Amber", "text": "Resin, vanilla, labdanum" } },
        { "type": "collection", "settings": { "title": "Fresh", "text": "Air, water, green" } },
        { "type": "collection", "settings": { "title": "Floral", "text": "Rose, iris, jasmine" } },
        { "type": "collection", "settings": { "title": "Gourmand", "text": "Tonka, praline, coffee" } },
        { "type": "collection", "settings": { "title": "Citrus", "text": "Bergamot, neroli, yuzu" } }
      ]
    }
  ]
}
{% endschema %}
