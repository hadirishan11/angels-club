{%- assign s = section.settings -%}
<section class="section scheme-{{ s.color_scheme }}" style="{% render 'section-style', pt: section.settings.padding_top, pb: section.settings.padding_bottom %}">
  <div class="page-width page-width--text{% if s.center %} text-center{% endif %}">
    {%- for block in section.blocks -%}
      <div class="reveal" style="--delay: {{ forloop.index0 | times: 100 }}ms;" {{ block.shopify_attributes }}>
        {%- case block.type -%}
          {%- when 'eyebrow' -%}
            <p class="eyebrow eyebrow--gold">{{ block.settings.text }}</p>
          {%- when 'heading' -%}
            <{{ block.settings.tag }} class="{{ block.settings.size }}">{{ block.settings.heading }}</{{ block.settings.tag }}>
          {%- when 'text' -%}
            <div class="rte{% if s.center %} center-block{% endif %}{% if block.settings.large %} text-lg{% endif %}">{{ block.settings.text }}</div>
          {%- when 'button' -%}
            <div class="mt-4"><a class="btn{% if block.settings.outline %} btn--outline{% endif %}" href="{{ block.settings.link | default: routes.root_url }}">{{ block.settings.label }}</a></div>
          {%- when 'divider' -%}
            <hr class="rule--gold" style="border: 0; border-top: 1px solid var(--c-gold);">
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "class": "section-rich-text",
  "settings": [
    { "type": "checkbox", "id": "center", "label": "Center text", "default": true },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "ivory", "label": "Ivory" },
        { "value": "ink", "label": "Ink" },
        { "value": "stone", "label": "Stone" }
      ],
      "default": "ivory"
    },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    { "type": "eyebrow", "name": "Small label", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Veloura" } ] },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "A private atelier for scent." },
        { "type": "select", "id": "tag", "label": "Tag (SEO)", "options": [ { "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" } ], "default": "h2" },
        { "type": "select", "id": "size", "label": "Size", "options": [ { "value": "h-display", "label": "Display" }, { "value": "h1", "label": "Large" }, { "value": "h2", "label": "Medium" }, { "value": "h3", "label": "Small" } ], "default": "h2" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We believe a fragrance should be lived in before it is bought. So we open the bottle for you.</p>" },
        { "type": "checkbox", "id": "large", "label": "Larger text", "default": false }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Read our story" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "checkbox", "id": "outline", "label": "Outline style", "default": true }
      ]
    },
    { "type": "divider", "name": "Gold hairline", "settings": [] }
  ],
  "presets": [
    { "name": "Rich text", "blocks": [ { "type": "eyebrow" }, { "type": "heading" }, { "type": "text" } ] }
  ]
}
{% endschema %}
