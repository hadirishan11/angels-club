<section class="section" style="--pt: var(--space-5); --pt-d: var(--space-6);">
  <div class="page-width">
    <header class="section-header section-header--center">
      <h1>{{ section.settings.heading }}</h1>
    </header>
    <ul class="grid" role="list" style="--cols-m: 2; --cols-t: 3; --cols-d: 4;">
      {%- for collection in collections -%}
        {%- unless collection.handle == 'frontpage' -%}
          <li class="reveal">
            <a class="card" href="{{ collection.url }}">
              <div class="media media--zoom" style="--ratio: 4 / 5;">
                {% render 'image', image: collection.featured_image, sizes: '(min-width: 990px) 25vw, 50vw', alt: collection.title, placeholder: 'collection-1' %}
              </div>
              <div class="card__body">
                <h2 class="card__title">{{ collection.title }}</h2>
                <p class="card__notes">{{ 'collections.general.items_count' | t: count: collection.products_count }}</p>
              </div>
            </a>
          </li>
        {%- endunless -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" } ]
}
{% endschema %}
