{%- if section.blocks.size > 0 -%}
<div class="announcement scheme-{{ section.settings.color_scheme }}" data-announcement data-speed="{{ section.settings.speed }}" role="region" aria-label="{{ 'sections.announcement.label' | t }}">
  <div class="page-width announcement__inner">
    {%- for block in section.blocks -%}
      <p class="announcement__slide mb-0" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
        {%- else -%}
          {{ block.settings.text }}
        {%- endif -%}
      </p>
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement",
  "max_blocks": 4,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "ink", "label": "Ink" },
        { "value": "ivory", "label": "Ivory" },
        { "value": "stone", "label": "Stone" }
      ],
      "default": "ink"
    },
    { "type": "range", "id": "speed", "label": "Seconds per message", "min": 3, "max": 10, "step": 1, "default": 5 }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Complimentary shipping over €75" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [ { "type": "message" } ]
    }
  ]
}
{% endschema %}
