{%- liquid
  assign s = section.settings
  assign products_to_show = s.products_to_show
  assign coll = s.collection
-%}
<section class="section scheme-{{ s.color_scheme }}" style="{% render 'section-style', pt: section.settings.padding_top, pb: section.settings.padding_bottom %}">
  <div class="page-width">
    <div class="section-header section-header--split reveal">
      <div>
        {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        <h2 class="mb-0">{{ s.heading }}</h2>
        {%- if s.text != blank -%}<div class="mt-2 text-muted">{{ s.text }}</div>{%- endif -%}
      </div>
      {%- if s.show_view_all and coll != blank -%}
        <a class="link" href="{{ coll.url }}">{{ s.view_all_label }} {% render 'icon', name: 'arrow-right' %}<span class="visually-hidden">: {{ coll.title }}</span></a>
      {%- endif -%}
    </div>

    <ul class="{% if s.layout == 'scroller' %}scroller scroller--desktop-grid{% else %}grid{% endif %}" role="list" style="--cols-m: 2; --cols-t: 3; --cols-d: {{ s.columns_desktop }};">
      {%- if coll != blank and coll.products_count > 0 -%}
        {%- for product in coll.products limit: products_to_show -%}
          <li>{% render 'product-card', product: product, index: forloop.index0 %}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..products_to_show) -%}
          <li>{% render 'product-card', product: blank, index: forloop.index0 %}</li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Featured scents",
  "class": "section-featured-collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "This season" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured scents" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "range", "id": "columns_desktop", "label": "Columns (desktop)", "min": 2, "max": 5, "step": 1, "default": 4 },
    {
      "type": "select",
      "id": "layout",
      "label": "Mobile layout",
      "options": [
        { "value": "scroller", "label": "Swipe" },
        { "value": "grid", "label": "Two-column grid" }
      ],
      "default": "scroller"
    },
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'View all'", "default": true },
    { "type": "text", "id": "view_all_label", "label": "'View all' label", "default": "View all" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "ivory", "label": "Ivory" },
        { "value": "ink", "label": "Ink" },
        { "value": "stone", "label": "Stone" }
      ],
      "default": "ivory"
    },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "presets": [ { "name": "Featured scents" } ]
}
{% endschema %}
