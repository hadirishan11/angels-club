{%- comment -%}
  Maison boutique — a first-person, cinematic walk into the Veloura store.
  Night façade → doors open → camera glides inside → three walls of real bottles
  (left: Noir, ahead: the house collection, right: Rosé). Drag / swipe / arrow keys to look around;
  pick a bottle off the shelf to inspect it, try a spritz, and drop it in the bag.
  Pure CSS 3D (no WebGL) so the product photography stays sharp. Without JS the shelves
  render as a normal, shoppable grid.
{%- endcomment -%}
{%- liquid
  assign c_left = section.settings.left_collection | default: settings.noir_collection
  assign c_back = section.settings.back_collection | default: collections.all
  assign c_right = section.settings.right_collection | default: settings.rose_collection
  if c_back == blank
    assign c_back = collections.all
  endif
  assign per_wall = section.settings.per_wall
-%}
{{ 'veloura-boutique.css' | asset_url | stylesheet_tag }}
<style>.bq-facade__lintel .bq-facade__sign,.bq-facade__lintel .bq-facade__sub{left:-610px;width:1600px}.bq:not(.is-open) .bq-ceiling{visibility:hidden}</style>
<script src="{{ 'veloura-boutique.js' | asset_url }}" defer></script>

<section class="bq" data-boutique data-skip-intro="{{ section.settings.allow_skip }}" aria-label="{{ section.settings.label | escape }}" style="--bq-h: {{ section.settings.height }}svh">
  <div class="bq__stage" data-bq-stage>
    <div class="bq__viewport" data-bq-viewport>
      <div class="bq__world" data-bq-world>

        {%- comment -%} ---------- the street-facing façade with opening doors ---------- {%- endcomment -%}
        <div class="bq-face bq-facade" aria-hidden="true">
          <span class="bq-facade__panel bq-facade__panel--l"></span>
          <span class="bq-facade__panel bq-facade__panel--r"></span>
          <span class="bq-facade__lintel">
            <span class="bq-facade__sign">{{ section.settings.sign | default: shop.name }}</span>
            <span class="bq-facade__sub">{{ section.settings.sign_sub }}</span>
          </span>
          <span class="bq-facade__awning"></span>
          <span class="bq-facade__glow"></span>
        </div>
        <span class="bq-face bq-door bq-door--l" aria-hidden="true"><span class="bq-door__handle"></span></span>
        <span class="bq-face bq-door bq-door--r" aria-hidden="true"><span class="bq-door__handle"></span></span>
        <div class="bq-face bq-street" aria-hidden="true"></div>

        {%- comment -%} ---------- the room shell ---------- {%- endcomment -%}
        <div class="bq-face bq-floor" aria-hidden="true"><span class="bq-floor__runner"></span></div>
        <div class="bq-face bq-ceiling" aria-hidden="true">
          <span class="bq-pendant" style="--x: 30%"></span><span class="bq-pendant" style="--x: 50%"></span><span class="bq-pendant" style="--x: 70%"></span>
        </div>

        {%- for w in (1..3) -%}
          {%- liquid
            case w
              when 1
                assign wall = 'left'
                assign wc = c_left
                assign wtitle = section.settings.left_title
                assign wworld = 'noir'
              when 2
                assign wall = 'back'
                assign wc = c_back
                assign wtitle = section.settings.back_title
                assign wworld = 'maison'
              when 3
                assign wall = 'right'
                assign wc = c_right
                assign wtitle = section.settings.right_title
                assign wworld = 'rose'
            endcase
            if wc == blank or wc.products_count == 0
              assign wc = collections.all
            endif
          -%}
          <div class="bq-face bq-wall bq-wall--{{ wall }} bq-wall--{{ wworld }}" data-bq-wall="{{ wall }}">
            <span class="bq-wall__wash" aria-hidden="true"></span>
            <div class="bq-wall__head">
              <p class="bq-wall__eyebrow">{{ wc.title }}</p>
              <h2 class="bq-wall__title">{{ wtitle }}</h2>
            </div>
            <ul class="bq-shelf" role="list" data-count="{{ wc.products_count | at_most: per_wall }}">
              {%- for p in wc.products limit: per_wall -%}
                {%- liquid
                  assign v = p.selected_or_first_available_variant
                  assign img = p.metafields.veloura.cutout.value | default: p.featured_media
                  assign is_cut = false
                  if p.metafields.veloura.cutout.value
                    assign is_cut = true
                  endif
                -%}
                <li class="bq-item">
                  <button class="bq-bottle{% if is_cut %} bq-bottle--cut{% endif %}" type="button"
                    data-bq-pick
                    data-handle="{{ p.handle }}"
                    data-url="{{ p.url }}"
                    data-variant="{{ v.id }}"
                    data-available="{{ p.available }}"
                    data-title="{{ p.title | escape }}"
                    data-vendor="{% unless p.vendor == 'My Store' %}{{ p.vendor | escape }}{% endunless %}"
                    data-price="{{ p.price | money | escape }}"
                    {%- if p.compare_at_price > p.price %} data-compare="{{ p.compare_at_price | money | escape }}"{% endif %}
                    data-type="{{ p.type | escape }}"
                    data-img="{% if img %}{{ img | image_url: width: 900 }}{% endif %}"
                    aria-label="Pick up {{ p.vendor | escape }} {{ p.title | escape }}, {{ p.price | money | strip_html | escape }}">
                    <span class="bq-bottle__alcove" aria-hidden="true">
                      <span class="bq-bottle__light"></span>
                      {%- if img -%}
                        {{ img | image_url: width: 420 | image_tag: loading: 'lazy', widths: '200, 300, 420', sizes: '200px', class: 'bq-bottle__img', alt: '' }}
                      {%- endif -%}
                      <span class="bq-bottle__shadow"></span>
                    </span>
                    <span class="bq-plaque">
                      {%- unless p.vendor == 'My Store' -%}<em>{{ p.vendor }}</em>{%- endunless -%}
                      <span class="bq-plaque__name">{{ p.title }}</span>
                      <span class="bq-plaque__price">{{ p.price | money }}</span>
                    </span>
                  </button>
                </li>
              {%- endfor -%}
            </ul>
            <span class="bq-shelf__glass" aria-hidden="true"></span>
          </div>
        {%- endfor -%}

      </div>
    </div>

    {%- comment -%} ---------- cinematic overlays ---------- {%- endcomment -%}
    <div class="bq__vignette" aria-hidden="true"></div>
    <div class="bq__motes" aria-hidden="true">{%- for i in (1..14) -%}<i style="--d: {{ i | times: 37 | modulo: 100 }}; --s: {{ i | times: 53 | modulo: 9 | plus: 6 }}"></i>{%- endfor -%}</div>
    <div class="bq__bars" aria-hidden="true"><span></span><span></span></div>

    {%- comment -%} ---------- title card ---------- {%- endcomment -%}
    <div class="bq__intro" data-bq-intro>
      <p class="bq__intro-eyebrow">{{ section.settings.intro_eyebrow }}</p>
      <h2 class="bq__intro-title">{{ section.settings.intro_title }}</h2>
      <p class="bq__intro-text">{{ section.settings.intro_text }}</p>
      <button class="btn btn--primary bq__enter" type="button" data-bq-enter>{{ section.settings.enter_label }} {% render 'icon', name: 'arrow' %}</button>
    </div>

    {%- comment -%} ---------- in-store HUD ---------- {%- endcomment -%}
    <div class="bq__hud" data-bq-hud hidden>
      <nav class="bq__walls" aria-label="{{ section.settings.nav_label | escape }}">
        <button type="button" data-bq-go="left">{{ section.settings.left_title | strip_html }}</button>
        <button type="button" data-bq-go="back">{{ section.settings.back_title | strip_html }}</button>
        <button type="button" data-bq-go="right">{{ section.settings.right_title | strip_html }}</button>
      </nav>
      <p class="bq__hint" data-bq-hint>{{ section.settings.hint }}</p>
      <button class="bq__bag" type="button" data-bq-bag aria-label="Your bag">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M6 8h12l-1 12H7L6 8zm3 0V6a3 3 0 0 1 6 0v2" fill="none" stroke="currentColor" stroke-width="1.3"/></svg>
        <span class="bq__bag-count" data-bq-count>{{ cart.item_count }}</span>
      </button>
      <button class="bq__exit" type="button" data-bq-exit>{{ section.settings.exit_label }}</button>
    </div>

    {%- comment -%} ---------- the picked-up bottle ---------- {%- endcomment -%}
    <div class="bq-inspect" data-bq-inspect role="dialog" aria-modal="true" aria-labelledby="BqTitle-{{ section.id }}" hidden>
      <div class="bq-inspect__hand" data-bq-hand>
        <img class="bq-inspect__img" data-bq-img alt="">
        <span class="bq-inspect__mist" data-bq-mist aria-hidden="true"></span>
      </div>
      <div class="bq-inspect__card">
        <p class="bq-inspect__vendor" data-bq-vendor></p>
        <h3 class="bq-inspect__title" id="BqTitle-{{ section.id }}" data-bq-title></h3>
        <p class="bq-inspect__price"><s data-bq-compare></s> <span data-bq-price></span> <small data-bq-size>· 10 ml atomiser</small></p>
        <ul class="bq-inspect__notes" data-bq-notes role="list"></ul>
        <p class="bq-inspect__desc" data-bq-desc></p>
        <p class="bq-inspect__whisper" data-bq-whisper aria-live="polite"></p>
        <div class="bq-inspect__actions">
          <button class="btn btn--primary" type="button" data-bq-add>{{ 'products.product.add_to_cart' | t }}</button>
          <button class="btn btn--outline" type="button" data-bq-spritz>{{ section.settings.spritz_label }}</button>
        </div>
        <div class="bq-inspect__links">
          <a class="link-underline" data-bq-link href="#">{{ section.settings.details_label }}</a>
          <button class="link-underline bq-inspect__back" type="button" data-bq-putback>{{ section.settings.putback_label }}</button>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Maison — boutique (POV)",
  "class": "section-maison-boutique",
  "settings": [
    { "type": "paragraph", "content": "A first-person walk into the store. Shelves fill themselves from the collections below and use each product's 'Vitrine cutout' image when set." },
    { "type": "text", "id": "sign", "label": "Shop sign", "default": "VELOURA" },
    { "type": "text", "id": "sign_sub", "label": "Sign subtitle", "default": "Maison de parfum · Canada" },
    { "type": "text", "id": "intro_eyebrow", "label": "Title card eyebrow", "default": "An evening at the maison" },
    { "type": "text", "id": "intro_title", "label": "Title card heading", "default": "Step <em>inside</em>" },
    { "type": "text", "id": "intro_text", "label": "Title card text", "default": "The doors are open. Browse the shelves, pick up what calls to you, and try a spritz." },
    { "type": "text", "id": "enter_label", "label": "Enter button", "default": "Enter the boutique" },
    { "type": "header", "content": "Walls" },
    { "type": "collection", "id": "left_collection", "label": "Left wall", "info": "Defaults to the Noir collection." },
    { "type": "text", "id": "left_title", "label": "Left wall title", "default": "<em>Noir</em>" },
    { "type": "collection", "id": "back_collection", "label": "Wall ahead", "info": "Defaults to all products." },
    { "type": "text", "id": "back_title", "label": "Wall ahead title", "default": "The <em>collection</em>" },
    { "type": "collection", "id": "right_collection", "label": "Right wall", "info": "Defaults to the Rosé collection." },
    { "type": "text", "id": "right_title", "label": "Right wall title", "default": "<em>Rosé</em>" },
    { "type": "range", "id": "per_wall", "label": "Bottles per wall", "min": 2, "max": 10, "step": 1, "default": 8 },
    { "type": "header", "content": "Labels" },
    { "type": "text", "id": "hint", "label": "Hint", "default": "Drag to look around · Pick a bottle off the shelf" },
    { "type": "text", "id": "spritz_label", "label": "Spritz button", "default": "Try a spritz" },
    { "type": "text", "id": "details_label", "label": "Details link", "default": "Full details" },
    { "type": "text", "id": "putback_label", "label": "Put back button", "default": "Put it back" },
    { "type": "text", "id": "exit_label", "label": "Leave button", "default": "Continue to the page" },
    { "type": "text", "id": "nav_label", "label": "Wall navigation label", "default": "Walls of the boutique" },
    { "type": "text", "id": "label", "label": "Accessible section label", "default": "The Veloura boutique" },
    { "type": "range", "id": "height", "label": "Height", "min": 80, "max": 100, "step": 5, "unit": "vh", "default": 100 },
    { "type": "checkbox", "id": "allow_skip", "label": "Returning visitors skip the entrance", "default": true }
  ],
  "presets": [{ "name": "Maison — boutique (POV)" }]
}
{% endschema %}
