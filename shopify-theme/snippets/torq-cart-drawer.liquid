<div class="scrim" id="scrim" hidden></div>
<aside class="drawer" id="drawer" aria-labelledby="drawerTitle" aria-hidden="true" role="dialog" aria-modal="true">
  <header>
    <h2 id="drawerTitle">Your cart</h2>
    <button class="icon-btn" id="closeCart" type="button" aria-label="Close cart"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"/></svg></button>
  </header>
  <div class="lines" id="lines"></div>
  <form class="drawer-foot" action="{{ routes.cart_url }}" method="post" id="drawerForm">
    <footer>
      <div class="ship-bar" aria-hidden="true" id="shipBar"><i id="shipFill"></i></div>
      <p class="ship-msg" id="shipMsg"></p>
      <div class="sum-row total-row"><span>Subtotal</span><span id="subOut"></span></div>
      <p class="fine" style="margin:0">Taxes and shipping calculated at checkout.</p>
      <button class="btn btn-orange" id="checkout" type="submit" name="checkout">Checkout</button>
      <p class="checkout-note" id="checkoutNote" role="status"></p>
    </footer>
  </form>
</aside>
