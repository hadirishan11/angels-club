{%- if section.blocks.size > 0 or request.design_mode -%}
<section class="sec" aria-labelledby="revTitle-{{ section.id }}">
  <div class="wrap">
    <div class="reviews-head">
      <div><span class="eyebrow">{{ section.settings.eyebrow | escape }}</span><h2 id="revTitle-{{ section.id }}" style="margin-top:14px">{{ section.settings.heading | escape }}</h2></div>
    </div>
    {%- if section.blocks.size == 0 -%}
      <p class="design-hint">Add real customer reviews as blocks, or add a reviews app block (for example Judge.me). This section is hidden from customers until it has content.</p>
    {%- else -%}
      <div class="reviews">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              <div style="grid-column:1/-1">{% render block %}</div>
            {%- when 'review' -%}
              <figure class="review" {{ block.shopify_attributes }}>
                <div class="stars" aria-label="{{ block.settings.rating }} out of 5 stars">
                  {%- for i in (1..5) -%}<svg class="{% if i > block.settings.rating %}off{% endif %}" aria-hidden="true"><use href="#star"/></svg>{%- endfor -%}
                </div>
                <blockquote>&ldquo;{{ block.settings.quote | escape }}&rdquo;</blockquote>
                <cite><b>{{ block.settings.author | escape }}</b>{{ block.settings.detail | escape }}</cite>
              </figure>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "TORQ reviews",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tasted. Rated." }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "paragraph", "content": "Only publish genuine reviews from real customers." },
        { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Review" },
        { "type": "text", "id": "author", "label": "Customer name" },
        { "type": "text", "id": "detail", "label": "Detail", "default": "Verified buyer" }
      ]
    }
  ],
  "presets": [{ "name": "TORQ reviews" }]
}
{% endschema %}
