<section class="sec" aria-labelledby="tl-{{ section.id }}">
  <div class="wrap">
    <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
    <h2 id="tl-{{ section.id }}" style="margin-top:14px">{{ section.settings.heading | escape }}</h2>
    <div class="timeline">
      {%- for block in section.blocks -%}
        <div class="t-row" {{ block.shopify_attributes }}><span class="yr">{{ block.settings.year | escape }}</span><div><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape }}</p></div></div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TORQ timeline",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How we got here" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our story so far." }
  ],
  "blocks": [
    { "type": "milestone", "name": "Milestone", "settings": [
      { "type": "text", "id": "year", "label": "Year", "default": "2026" },
      { "type": "text", "id": "title", "label": "Title", "default": "Milestone" },
      { "type": "textarea", "id": "text", "label": "Text" } ] }
  ],
  "presets": [
    { "name": "TORQ timeline", "blocks": [
      { "type": "milestone", "settings": { "year": "2021", "title": "Kitchen batches", "text": "Forty test recipes in a shared kitchen. Recipe 31 is the one." } },
      { "type": "milestone", "settings": { "year": "2023", "title": "Direct sourcing", "text": "Multi-year contracts with growers so the flavor stays the same every season." } },
      { "type": "milestone", "settings": { "year": "2026", "title": "Five flavors", "text": "Four new flavors join the original. Same formula, same 160mg." } }
    ] }
  ]
}
{% endschema %}
