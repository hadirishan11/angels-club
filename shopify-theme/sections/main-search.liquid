<div class="wrap page-wrap">
  <h1>Search</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" class="form-card" style="margin-bottom:40px">
    <div class="field-row">
      <label for="q">Search the store</label>
      <input id="q" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Try 'lime'">
    </div>
    <button class="btn btn-orange" type="submit" style="align-self:flex-start">Search</button>
  </form>
  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      <p class="find-count">{{ search.results_count }} results for &ldquo;{{ search.terms | escape }}&rdquo;</p>
      <div class="grid-products" style="margin-top:20px">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {% render 'torq-card', product: item %}
          {%- else -%}
            <a class="card" href="{{ item.url }}"><div class="body"><b>{{ item.title | escape }}</b><span>{{ item.content | strip_html | truncatewords: 20 }}</span></div></a>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {% render 'torq-pagination', paginate: paginate %}
    {%- endpaginate -%}
  {%- endif -%}
</div>
{% schema %}
{ "name": "Search", "settings": [] }
{% endschema %}
