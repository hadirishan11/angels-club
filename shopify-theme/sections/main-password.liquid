<div class="hero" style="min-height:100vh;grid-template-rows:auto">
  <div class="hero-word" aria-hidden="true" style="top:40%"><span>T</span><span>O</span><span>R</span><span>Q</span></div>
  <div class="wrap" style="position:relative;z-index:4;align-self:end;padding-block:40px 60px">
    <div class="form-card" style="background:var(--ink);color:var(--peel);padding:28px;border-radius:28px">
      <h1 style="font-size:2.6rem">{{ section.settings.heading | escape }}</h1>
      {%- if shop.password_message != blank -%}<p>{{ shop.password_message | escape }}</p>{%- endif -%}
      {%- form 'customer', class: 'form-card' -%}
        <input type="hidden" name="contact[tags]" value="prospect,password page">
        {%- if form.posted_successfully? -%}
          <p class="success">Thanks. We'll email you when we launch.</p>
        {%- else -%}
          <div class="field-row"><label for="pw-email">Email</label><input id="pw-email" type="email" name="contact[email]" autocomplete="email" required></div>
          <button class="btn btn-orange" type="submit">Notify me</button>
        {%- endif -%}
      {%- endform -%}
      <details>
        <summary style="cursor:pointer;font-weight:700">{{ 'general.password_page.login_form_heading' | t }}</summary>
        {%- form 'storefront_password', class: 'form-card' -%}
          {%- if form.errors -%}<p class="errors">{{ 'general.password_page.login_form_error' | t }}</p>{%- endif -%}
          <div class="field-row"><label for="pw">{{ 'general.password_page.login_form_password_label' | t }}</label><input id="pw" type="password" name="password" autocomplete="current-password"></div>
          <button class="btn btn-ghost" type="submit">{{ 'general.password_page.login_password_button' | t }}</button>
        {%- endform -%}
      </details>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon." }
  ]
}
{% endschema %}
