<div class="wrap page-wrap">
  <h1>Reset password</h1>
  {%- form 'reset_customer_password', class: 'form-card' -%}
    {%- if form.errors -%}<div class="errors">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="field-row"><label for="rs-pw">New password</label><input id="rs-pw" type="password" name="customer[password]" autocomplete="new-password" required></div>
    <div class="field-row"><label for="rs-pw2">Confirm password</label><input id="rs-pw2" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
    <button class="btn btn-orange" type="submit" style="align-self:flex-start">Reset password</button>
  {%- endform -%}
</div>
