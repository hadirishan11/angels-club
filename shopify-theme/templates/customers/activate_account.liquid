<div class="wrap page-wrap">
  <h1>Activate account</h1>
  {%- form 'activate_customer_password', class: 'form-card' -%}
    {%- if form.errors -%}<div class="errors">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="field-row"><label for="act-pw">Password</label><input id="act-pw" type="password" name="customer[password]" autocomplete="new-password" required></div>
    <div class="field-row"><label for="act-pw2">Confirm password</label><input id="act-pw2" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
    <button class="btn btn-orange" type="submit" style="align-self:flex-start">Activate account</button>
  {%- endform -%}
</div>
