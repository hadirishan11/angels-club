<div class="wrap page-wrap">
  <p class="link-row"><a href="{{ routes.account_url }}">&larr; Back to account</a></p>
  <h1>Addresses</h1>
  {%- paginate customer.addresses by 10 -%}
    <div class="two-col">
      <div>
        {%- for address in customer.addresses -%}
          <div style="border:2px solid var(--blood-3);border-radius:20px;padding:20px;margin-bottom:16px">
            {%- if address == customer.default_address -%}<span class="eyebrow">Default</span>{%- endif -%}
            <p>{{ address | format_address }}</p>
            {%- form 'customer_address', address -%}
              <input type="hidden" name="_method" value="delete">
              <button class="btn btn-ghost" type="submit" style="min-height:44px;font-size:1rem">Delete</button>
            {%- endform -%}
          </div>
        {%- else -%}
          <p class="lede">No saved addresses yet.</p>
        {%- endfor -%}
        {% render 'torq-pagination', paginate: paginate %}
      </div>
      <div>
        <h2 style="font-size:2rem;margin-bottom:16px">Add a new address</h2>
        {%- form 'customer_address', customer.new_address, class: 'form-card' -%}
          {%- if form.errors -%}<div class="errors">{{ form.errors | default_errors }}</div>{%- endif -%}
          <div class="field-row"><label for="a-first">First name</label><input id="a-first" name="address[first_name]" autocomplete="given-name" value="{{ form.first_name }}"></div>
          <div class="field-row"><label for="a-last">Last name</label><input id="a-last" name="address[last_name]" autocomplete="family-name" value="{{ form.last_name }}"></div>
          <div class="field-row"><label for="a-a1">Address</label><input id="a-a1" name="address[address1]" autocomplete="address-line1" value="{{ form.address1 }}"></div>
          <div class="field-row"><label for="a-a2">Apartment, suite, etc.</label><input id="a-a2" name="address[address2]" autocomplete="address-line2" value="{{ form.address2 }}"></div>
          <div class="field-row"><label for="a-city">City</label><input id="a-city" name="address[city]" autocomplete="address-level2" value="{{ form.city }}"></div>
          <div class="field-row"><label for="a-country">Country</label><select id="a-country" name="address[country]" autocomplete="country">{{ all_country_option_tags }}</select></div>
          <div class="field-row"><label for="a-prov">State / province</label><input id="a-prov" name="address[province]" autocomplete="address-level1" value="{{ form.province }}"></div>
          <div class="field-row"><label for="a-zip">Postal code</label><input id="a-zip" name="address[zip]" autocomplete="postal-code" value="{{ form.zip }}"></div>
          <div class="field-row"><label for="a-phone">Phone</label><input id="a-phone" type="tel" name="address[phone]" autocomplete="tel" value="{{ form.phone }}"></div>
          <label style="display:flex;gap:10px;align-items:center"><input type="checkbox" name="address[default]" value="1"> Set as default address</label>
          <button class="btn btn-orange" type="submit" style="align-self:flex-start">Add address</button>
        {%- endform -%}
      </div>
    </div>
  {%- endpaginate -%}
</div>
