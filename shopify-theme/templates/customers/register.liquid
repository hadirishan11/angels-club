<div class="wrap page-wrap">
  <h1>Create account</h1>
  {%- form 'create_customer', class: 'form-card' -%}
    {%- if form.errors -%}<div class="errors">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="field-row"><label for="reg-first">First name</label><input id="reg-first" type="text" name="customer[first_name]" autocomplete="given-name"></div>
    <div class="field-row"><label for="reg-last">Last name</label><input id="reg-last" type="text" name="customer[last_name]" autocomplete="family-name"></div>
    <div class="field-row"><label for="reg-email">Email</label><input id="reg-email" type="email" name="customer[email]" autocomplete="email" required></div>
    <div class="field-row"><label for="reg-pw">Password</label><input id="reg-pw" type="password" name="customer[password]" autocomplete="new-password" required></div>
    <button class="btn btn-orange" type="submit" style="align-self:flex-start">Create account</button>
  {%- endform -%}
</div>
